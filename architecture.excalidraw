    {
      "id": "DSBTTbc4mUjL7-j2ScUWs",
      "type": "text",
      "x": -74.47797766678025,
      "y": -286.99156654939,
      "width": 695.9998779296875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
