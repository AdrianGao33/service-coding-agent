      "text": "# 请求独立llm评判，返回“should_block\": true/false 和 reason\nasync def classify(messages, tool_name: str, args: dict) -> dict:\n    transcript = build_transcript(messages, tool_name, args)\n    try:\n        response = await _client.chat.completions.create(\n            model=CLASSIFIER_MODEL,\n            messages=[\n                {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n                {\"role\": \"user\", \"content\": transcript},\n            ],\n            \n            temperature=0,  # 禁用随机采样，确保安全判定稳定可复现\n            response_format={\"type\": \"json_object\"},  # 强制输出合法 JSON 结构\n        )\n        verdict = json.loads(response.choices[0].message.content)\n        return {\n            \"should_block\": bool(verdict[\"should_block\"]),\n            \"reason\": str(verdict.get(\"reason\", \"未给出理由\")),\n        }\n    except Exception as e:\n        return {\n            \"should_block\": True,\n            \"reason\": f\"classifier 出错（{type(e).__name__}），回退人工审批\",\n            \"error\": True,\n        }",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 请求独立llm评判，返回“should_block\": true/false 和 reason\nasync def classify(messages, tool_name: str, args: dict) -> dict:\n    transcript = build_transcript(messages, tool_name, args)\n    try:\n        response = await _client.chat.completions.create(\n            model=CLASSIFIER_MODEL,\n            messages=[\n                {\"role\": \"system\", \"content\": SYSTEM_PROMPT},\n                {\"role\": \"user\", \"content\": transcript},\n            ],\n            \n            temperature=0,  # 禁用随机采样，确保安全判定稳定可复现\n            response_format={\"type\": \"json_object\"},  # 强制输出合法 JSON 结构\n        )\n        verdict = json.loads(response.choices[0].message.content)\n        return {\n            \"should_block\": bool(verdict[\"should_block\"]),\n            \"reason\": str(verdict.get(\"reason\", \"未给出理由\")),\n        }\n    except Exception as e:\n        return {\n            \"should_block\": True,\n            \"reason\": f\"classifier 出错（{type(e).__name__}），回退人工审批\",\n            \"error\": True,\n        }",
      "autoResize": true,
