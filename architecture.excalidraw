      "updated": 1793342742042,
      "link": null,
      "locked": false,
      "text": "def job_kill(ctx: RunContext[AgentDeps], job_id: str) -> str:\n    registry = ctx.deps.job_registry\n    job = registry.get(job_id)\n    \n    if job is None:\n        raise ModelRetry(f\"job {job_id} 不存在\")\n        \n    if not registry.kill(job_id):       #在判断语句中调用了kill\n        return f\"job {job_id} 已经结束（{job.status}），无需终止\"\n        \n    return f\"job {job_id} 已终止\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def job_kill(ctx: RunContext[AgentDeps], job_id: str) -> str:\n    registry = ctx.deps.job_registry\n    job = registry.get(job_id)\n    \n    if job is None:\n        raise ModelRetry(f\"job {job_id} 不存在\")\n        \n    if not registry.kill(job_id):       #在判断语句中调用了kill\n        return f\"job {job_id} 已经结束（{job.status}），无需终止\"\n        \n    return f\"job {job_id} 已终止\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
