      "link": null,
      "locked": false,
      "text": "# 2. 询问人工判断函数(ask的判断处理)\nasync def prompt_approval(tool_name: str, args: dict) -> str:\n    \"\"\"\n    工具执行前弹出审批 picker，返回 \"once\" / \"always\" / \"deny\"。\n    \"\"\"\n    options = [\n        (\"once\", \"允许\"),\n        (\"always\", f\"允许，且本会话不再询问 {tool_name}\"),\n        (\"deny\", \"拒绝\"),\n    ]\n    async with in_terminal():\n        question = f\"是否允许执行 {_format_call(tool_name, args)}？\"\n        choice = await _ApprovalPicker(question, options).run()\n    return choice\n# 手绘终端ask—UI单选：once、always、deny\nclass _ApprovalPicker:\n    ...UI...\ndef _format_call(tool_name: str, args: dict) -> str:\n    ...压缩判断问题...",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 2. 询问人工判断函数(ask的判断处理)\nasync def prompt_approval(tool_name: str, args: dict) -> str:\n    \"\"\"\n    工具执行前弹出审批 picker，返回 \"once\" / \"always\" / \"deny\"。\n    \"\"\"\n    options = [\n        (\"once\", \"允许\"),\n        (\"always\", f\"允许，且本会话不再询问 {tool_name}\"),\n        (\"deny\", \"拒绝\"),\n    ]\n    async with in_terminal():\n        question = f\"是否允许执行 {_format_call(tool_name, args)}？\"\n        choice = await _ApprovalPicker(question, options).run()\n    return choice\n# 手绘终端ask—UI单选：once、always、deny\nclass _ApprovalPicker:\n    ...UI...\ndef _format_call(tool_name: str, args: dict) -> str:\n    ...压缩判断问题...",
      "autoResize": true,
      "lineHeight": 1.25
    },
