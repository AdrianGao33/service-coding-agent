      "text": "async def prompt_approval(tool_name: str, args: dict) -> str:\n    options = [\n        (\"once\", \"允许\"),\n        (\"always\", f\"允许，且本会话不再询问 {tool_name}\"),\n        (\"deny\", \"拒绝\"),\n    ]\n    async with in_terminal():\n        question = f\"是否允许执行 {_format_call(tool_name, args)}？\"\n        choice = await _ApprovalPicker(question, options).run()\n    return choice\n\n# 手绘终端ask—UI单选：once、always、deny\nclass _ApprovalPicker:\n    ...UI...\ndef _format_call(tool_name: str, args: dict) -> str:\n    ...压缩判断问题...",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def prompt_approval(tool_name: str, args: dict) -> str:\n    options = [\n        (\"once\", \"允许\"),\n        (\"always\", f\"允许，且本会话不再询问 {tool_name}\"),\n        (\"deny\", \"拒绝\"),\n    ]\n    async with in_terminal():\n        question = f\"是否允许执行 {_format_call(tool_name, args)}？\"\n        choice = await _ApprovalPicker(question, options).run()\n    return choice\n\n# 手绘终端ask—UI单选：once、always、deny\nclass _ApprovalPicker:\n    ...UI...\ndef _format_call(tool_name: str, args: dict) -> str:\n    ...压缩判断问题...",
      "autoResize": true,
      "lineHeight": 1.25
    },
