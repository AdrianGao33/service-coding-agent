    {
      "id": "18xCP2ReJhRSlUfAofEjF",
      "type": "text",
      "x": -6033.984805704288,
      "y": -712.1232711962793,
      "width": 880.7996215820312,
      "height": 620,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "p0F1Lo_5Ppy1J_dcWJUQ5",
        "ypSRAejk1Fx1xv7gsflln"
      ],
      "frameId": null,
      "index": "b5KV",
      "roundness": null,
      "seed": 248991983,
      "version": 494,
      "versionNonce": 434780097,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "UCFQWh1y0bamuR3jB2M_S",
