      "updated": 1791991845441,
      "link": null,
      "locked": false,
      "text": "class ReadFileState:\n    def __init__(self):\n        # 字典映射：绝对路径 -> {1.\"content\": 文本, 2.\"timestamp\": 3.mtime时间戳, 4.\"offset\": 行偏移, 5.\"limit\": 读取行数}\n        self._state: dict = {}\n\n    def record(self, path: str, content: str, offset: int | None = None, limit: int | None = None) -> None:\n        self._state[os.path.abspath(path)] = {\n            \"content\": content,\n            \"timestamp\": os.path.getmtime(path), #系统捕获触发自动记录\n            \"offset\": offset,\n            \"limit\": limit,\n        }\n\n    def get(self, path: str):\n        return self._state.get(os.path.abspath(path))",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class ReadFileState:\n    def __init__(self):\n        # 字典映射：绝对路径 -> {1.\"content\": 文本, 2.\"timestamp\": 3.mtime时间戳, 4.\"offset\": 行偏移, 5.\"limit\": 读取行数}\n        self._state: dict = {}\n\n    def record(self, path: str, content: str, offset: int | None = None, limit: int | None = None) -> None:\n        self._state[os.path.abspath(path)] = {\n            \"content\": content,\n            \"timestamp\": os.path.getmtime(path), #系统捕获触发自动记录\n            \"offset\": offset,\n            \"limit\": limit,\n        }\n\n    def get(self, path: str):\n        return self._state.get(os.path.abspath(path))",
      "autoResize": true,
      "lineHeight": 1.25
    },
