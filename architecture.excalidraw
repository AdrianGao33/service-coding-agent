      "originalText": "def memory_dir() -> Path:\n    return session.project_dir() / \"memory\"\n\ndef index_path() -> Path:\n    return memory_dir() / \"MEMORY.md\"\n\ndef ensure_memory_dir() -> None:\n    memory_dir().mkdir(parents=True, exist_ok=True)",
      "autoResize": true,
