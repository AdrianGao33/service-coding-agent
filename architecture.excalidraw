      "link": null,
      "locked": false,
      "text": "def format_manifest(headers: list[MemoryHeader]) -> str:\n    lines = []\n    for h in headers:\n        day = datetime.fromtimestamp(h.mtime).strftime(\"%Y-%m-%d\")\n        lines.append(f\"- [{h.type}] {h.filename}（{day}）：{h.description}\")\n    return \"\\n\".join(lines)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def format_manifest(headers: list[MemoryHeader]) -> str:\n    lines = []\n    for h in headers:\n        day = datetime.fromtimestamp(h.mtime).strftime(\"%Y-%m-%d\")\n        lines.append(f\"- [{h.type}] {h.filename}（{day}）：{h.description}\")\n    return \"\\n\".join(lines)",
      "autoResize": true,
      "lineHeight": 1.25
