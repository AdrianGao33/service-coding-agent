      "link": null,
      "locked": false,
      "text": "def shutdown(self) -> int:\n    running = self.running()\n    for job in running:\n        self.kill(job.id)\n    return len(running)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def shutdown(self) -> int:\n    running = self.running()\n    for job in running:\n        self.kill(job.id)\n    return len(running)",
      "autoResize": true,
      "lineHeight": 1.25
    },
