      "updated": 1793343702915,
      "link": null,
      "locked": false,
      "text": "async def spawn_shell(self, command: str, background: bool = True) -> Job:\n    job_id = _new_job_id()\n    self._jobs_dir.mkdir(parents=True, exist_ok=True)      \n    log_path = self._jobs_dir / f\"{job_id}.log\"\n    log_file = open(log_path, \"wb\")\n\n    if os.name == \"nt\":\n        group_kwargs = {\"creationflags\": subprocess.CREATE_NEW_PROCESS_GROUP}\n    else:\n        group_kwargs = {\"start_new_session\": True}\n\n    proc = await asyncio.create_subprocess_shell(\n        command, stdout=log_file, stderr=subprocess.STDOUT, **group_kwargs\n    )\n    pid = proc.pid\n\n    job = Job(\n        id=job_id,\n        kind=\"shell\",\n        description=command,\n        log_path=log_path,\n        background=background,\n        kill_func=lambda: _kill_process_tree(pid),\n    )\n    self._jobs[job_id] = job\n\n    watcher = asyncio.create_task(self._watch(job, proc, log_file))\n    self._watchers.add(watcher)\n    watcher.add_done_callback(self._watchers.discard)\n    return job",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def spawn_shell(self, command: str, background: bool = True) -> Job:\n    job_id = _new_job_id()\n    self._jobs_dir.mkdir(parents=True, exist_ok=True)      \n    log_path = self._jobs_dir / f\"{job_id}.log\"\n    log_file = open(log_path, \"wb\")\n\n    if os.name == \"nt\":\n        group_kwargs = {\"creationflags\": subprocess.CREATE_NEW_PROCESS_GROUP}\n    else:\n        group_kwargs = {\"start_new_session\": True}\n\n    proc = await asyncio.create_subprocess_shell(\n        command, stdout=log_file, stderr=subprocess.STDOUT, **group_kwargs\n    )\n    pid = proc.pid\n\n    job = Job(\n        id=job_id,\n        kind=\"shell\",\n        description=command,\n        log_path=log_path,\n        background=background,\n        kill_func=lambda: _kill_process_tree(pid),\n    )\n    self._jobs[job_id] = job\n\n    watcher = asyncio.create_task(self._watch(job, proc, log_file))\n    self._watchers.add(watcher)\n    watcher.add_done_callback(self._watchers.discard)\n    return job",
      "autoResize": true,
      "lineHeight": 1.25
    },
