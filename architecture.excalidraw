      "updated": 1793188911010,
      "link": null,
      "locked": false,
      "text": "def _transport(toolset: Any) -> str:\n    wrapped = getattr(toolset, \"wrapped\", toolset)\n    \n    if hasattr(wrapped, \"command\"):   # 有 command 说明是本地子进程命令行通信\n        args = list(getattr(wrapped, \"args\", []))\n        return \"stdio: \" + \" \".join([getattr(wrapped, \"command\", \"\"), *args])\n    \n    if hasattr(wrapped, \"url\"):    # 有 url 说明是远程网络通信\n        return f\"http: {wrapped.url}\"\n    raw_url = getattr(getattr(toolset, \"client\", None), \"url\", None)\n    \n    if raw_url:\n        return f\"http: {raw_url}\"\n    return \"transport: unknown\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def _transport(toolset: Any) -> str:\n    wrapped = getattr(toolset, \"wrapped\", toolset)\n    \n    if hasattr(wrapped, \"command\"):   # 有 command 说明是本地子进程命令行通信\n        args = list(getattr(wrapped, \"args\", []))\n        return \"stdio: \" + \" \".join([getattr(wrapped, \"command\", \"\"), *args])\n    \n    if hasattr(wrapped, \"url\"):    # 有 url 说明是远程网络通信\n        return f\"http: {wrapped.url}\"\n    raw_url = getattr(getattr(toolset, \"client\", None), \"url\", None)\n    \n    if raw_url:\n        return f\"http: {raw_url}\"\n    return \"transport: unknown\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
