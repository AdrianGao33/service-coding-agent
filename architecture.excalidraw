      "updated": 1793340761805,
      "link": null,
      "locked": false,
      "text": "SHELL_META = re.compile(r\"[;&|<>`$\\n]\") #黑名单：操作符（重定向）\nREADONLY_COMMANDS = {...白名单：只读命令...}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SHELL_META = re.compile(r\"[;&|<>`$\\n]\") #黑名单：操作符（重定向）\nREADONLY_COMMANDS = {...白名单：只读命令...}",
      "autoResize": true,
      "lineHeight": 1.25
    },
