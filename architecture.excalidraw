      "link": null,
      "locked": false,
      "text": "\n# 0. 工具自检注册表字典: key 为工具名（如 \"run_command\"），value 为自检函数 (run_command_self_check)\n    TOOL_SELF_CHECKS = {}\n\n    def register_self_check(tool_name: str, check) -> None:\n    TOOL_SELF_CHECKS[tool_name] = check\n\n# 1. 核心判断：放行（allow）or 拦截（ask）\n# 根据当前模式、是否“不再询问”、白名单、危险操作、按优先级判断\ndef compute_decision(tool_name: str, args: dict) -> str:\n    if state.mode == BYPASS:\n        return \"allow\"\n    check = TOOL_SELF_CHECKS.get(tool_name)\n    if check and check(args) == \"ask\":\n        return \"ask\"\n    if tool_name in state.session_allowed:\n        return \"allow\"\n    if tool_name in READONLY_TOOLS:\n        return \"allow\"\n    if state.mode == ACCEPT_EDITS and tool_name in EDIT_TOOLS:\n        return \"allow\"\n    return \"ask\"\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n# 0. 工具自检注册表字典: key 为工具名（如 \"run_command\"），value 为自检函数 (run_command_self_check)\n    TOOL_SELF_CHECKS = {}\n\n    def register_self_check(tool_name: str, check) -> None:\n    TOOL_SELF_CHECKS[tool_name] = check\n\n# 1. 核心判断：放行（allow）or 拦截（ask）\n# 根据当前模式、是否“不再询问”、白名单、危险操作、按优先级判断\ndef compute_decision(tool_name: str, args: dict) -> str:\n    if state.mode == BYPASS:\n        return \"allow\"\n    check = TOOL_SELF_CHECKS.get(tool_name)\n    if check and check(args) == \"ask\":\n        return \"ask\"\n    if tool_name in state.session_allowed:\n        return \"allow\"\n    if tool_name in READONLY_TOOLS:\n        return \"allow\"\n    if state.mode == ACCEPT_EDITS and tool_name in EDIT_TOOLS:\n        return \"allow\"\n    return \"ask\"\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
