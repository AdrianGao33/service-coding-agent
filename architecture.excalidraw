      "updated": 1792320746013,
      "link": null,
      "locked": false,
      "text": "TaskStatus = Literal[\"pending\", \"in_progress\", \"completed\"]\n\n@dataclass\nclass Task:\n    id: str                         \n    subject: str                    \n    description: str                \n    active_form: str | None = None  \n    status: TaskStatus = \"pending\"  \n    blocks: list[str] = field(default_factory=list)    \n    blocked_by: list[str] = field(default_factory=list) \n\n_HIGHWATERMARK = \".highwatermark\"   # 存放历史最大 ID 的隐藏文件名\n\ndef _data_root() -> Path:\n    return Path.home() / \".my-code-agent\"\n\nclass TasksStore:\n    def __init__(self, session_id: str):\n        self.session_id = session_id\n        self.dir = _data_root() / \"tasks\" / session_id\n        self.dir.mkdir(parents=True, exist_ok=True)\n\n        self._tasks: dict[str, Task] = {}\n        for path in self._json_paths(): #如果有曾经在对话存放的任务json，使用resume时候加载到内存\n            try:\n                task = Task(**json.loads(path.read_text(encoding=\"utf-8\")))\n            except (OSError, json.JSONDecodeError, TypeError):\n                continue\n            self._tasks[task.id] = task\n  \n        self._highwatermark = self._read_highwatermark()",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "TaskStatus = Literal[\"pending\", \"in_progress\", \"completed\"]\n\n@dataclass\nclass Task:\n    id: str                         \n    subject: str                    \n    description: str                \n    active_form: str | None = None  \n    status: TaskStatus = \"pending\"  \n    blocks: list[str] = field(default_factory=list)    \n    blocked_by: list[str] = field(default_factory=list) \n\n_HIGHWATERMARK = \".highwatermark\"   # 存放历史最大 ID 的隐藏文件名\n\ndef _data_root() -> Path:\n    return Path.home() / \".my-code-agent\"\n\nclass TasksStore:\n    def __init__(self, session_id: str):\n        self.session_id = session_id\n        self.dir = _data_root() / \"tasks\" / session_id\n        self.dir.mkdir(parents=True, exist_ok=True)\n\n        self._tasks: dict[str, Task] = {}\n        for path in self._json_paths(): #如果有曾经在对话存放的任务json，使用resume时候加载到内存\n            try:\n                task = Task(**json.loads(path.read_text(encoding=\"utf-8\")))\n            except (OSError, json.JSONDecodeError, TypeError):\n                continue\n            self._tasks[task.id] = task\n  \n        self._highwatermark = self._read_highwatermark()",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "kZkz5I6ThCiW_rRg4d_9w",
      "type": "text",
      "x": -271.2978705216335,
      "y": -2938.4843823073943,
      "width": 628.4797973632812,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "bxXYNgJAjC4pUVBbGx-gf",
        "Gxr4EvzE8Pci49XbpE6rg",
        "XQpvhALE27R09d-i2vhV2",
        "kSQLqTkN_Fpsm5fGfntB6"
      ],
      "frameId": null,
