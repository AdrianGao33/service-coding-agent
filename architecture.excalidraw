      "link": null,
      "locked": false,
      "text": "fork_agent = Agent(\n    model,\n    instructions=INSTRUCTIONS,\n    tools=[read_file, \n           Tool(edit_file, sequential=True), \n           Tool(write_file, sequential=True)\n          ],\n    deps_type=AgentDeps,\n    capabilities=[fork_hooks],\n)",
