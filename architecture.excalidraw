      "updated": 1793342724006,
      "link": null,
      "locked": false,
      "text": "def _kill_process_tree(pid: int) -> None:\n    if os.name == \"nt\":\n        subprocess.run([\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)], capture_output=True)\n    else:\n        try:\n            os.killpg(os.getpgid(pid), signal.SIGTERM)\n        except ProcessLookupError:\n            pass\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def _kill_process_tree(pid: int) -> None:\n    if os.name == \"nt\":\n        subprocess.run([\"taskkill\", \"/F\", \"/T\", \"/PID\", str(pid)], capture_output=True)\n    else:\n        try:\n            os.killpg(os.getpgid(pid), signal.SIGTERM)\n        except ProcessLookupError:\n            pass\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
