      "text": "# 提供给main.py用的UI渲染函数 + 命令command注册对象\n\n# 1. UI打印（判断多种part情况、美化、渲染）\ndef print_part(part) -> None:\n\n\n# 2. Command 命令抽象类，所有斜杠命令都要注册成 Command 对象\nclass Command:\n    name: str\n    description: str\n    handler: Callable[[\"SessionState\"], bool]\n\nCOMMANDS = {\n    \"new\": Command(\"new\", \"开启新会话\", cmd_new),\n    \"resume\": Command(\"resume\", \"恢复历史会话\", cmd_resume),\n    \"status\": Command(\"status\", \"显示当前会话状态\", cmd_status),\n    \"memory\": Command(\"memory\", \"查看长期记忆\", cmd_memory),\n    \"dream\": Command(\"dream\", \"立即整理合并长期记忆\", cmd_dream),\n    \"api-detail\": Command(\"api-detail\", \"显示最近一轮 model API 调用详情\", cmd_api_detail),\n    \"help\": Command(\"help\", \"显示可用命令\", cmd_help),\n    \"exit\": Command(\"exit\", \"退出程序\", cmd_exit),\n}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 提供给main.py用的UI渲染函数 + 命令command注册对象\n\n# 1. UI打印（判断多种part情况、美化、渲染）\ndef print_part(part) -> None:\n\n\n# 2. Command 命令抽象类，所有斜杠命令都要注册成 Command 对象\nclass Command:\n    name: str\n    description: str\n    handler: Callable[[\"SessionState\"], bool]\n\nCOMMANDS = {\n    \"new\": Command(\"new\", \"开启新会话\", cmd_new),\n    \"resume\": Command(\"resume\", \"恢复历史会话\", cmd_resume),\n    \"status\": Command(\"status\", \"显示当前会话状态\", cmd_status),\n    \"memory\": Command(\"memory\", \"查看长期记忆\", cmd_memory),\n    \"dream\": Command(\"dream\", \"立即整理合并长期记忆\", cmd_dream),\n    \"api-detail\": Command(\"api-detail\", \"显示最近一轮 model API 调用详情\", cmd_api_detail),\n    \"help\": Command(\"help\", \"显示可用命令\", cmd_help),\n    \"exit\": Command(\"exit\", \"退出程序\", cmd_exit),\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "AaexNdQ-lvalSmstZl7P5",
      "type": "text",
      "x": 431.6055481925797,
      "y": -3794.6746031745993,
      "width": 1268.979248046875,
      "height": 300,
      "angle": 0,
      "strokeColor": "#e03131",
