      "text": "class Job:                                     \n    id: str                                         \n    kind: str                                      # 种类\n    description: str                               # 描述\n    log_path: Path                                 # 输出日志文件储存地址\n    status: JobStatus = \"running\"                  # 状态：running/completed/failed/killed\n    returncode: int | None = None                  # 退出码，默认为none\n    notified: bool = False                         # 任务结束后，是否已经通知主Agent\n    background: bool = True                        # 是否为后台长任务\n    kill_func: Callable[[], None] | None = None     ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Job:                                     \n    id: str                                         \n    kind: str                                      # 种类\n    description: str                               # 描述\n    log_path: Path                                 # 输出日志文件储存地址\n    status: JobStatus = \"running\"                  # 状态：running/completed/failed/killed\n    returncode: int | None = None                  # 退出码，默认为none\n    notified: bool = False                         # 任务结束后，是否已经通知主Agent\n    background: bool = True                        # 是否为后台长任务\n    kill_func: Callable[[], None] | None = None     ",
      "autoResize": true,
      "lineHeight": 1.25
    },
