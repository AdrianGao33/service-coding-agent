      "originalText": "# 校验改动的文件地址是否在memory📂 | 校验是否操作是记忆文件修改操作",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "m0kCKA1eRIsdAzcrnzLF6",
      "type": "text",
      "x": -78.92242211122414,
      "y": 275.2306556728324,
      "width": 633.59912109375,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
