    {
      "id": "pNFlPNwHv2ddz_cvbYrCH",
      "type": "text",
      "x": -5880.079365079365,
      "y": -3619.4206349206356,
      "width": 492.79931640625,
      "height": 560,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VMtGU08fn6eLLwyEtiMiK"
      ],
      "frameId": null,
      "index": "b0Fl",
