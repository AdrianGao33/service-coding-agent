      ],
      "updated": 1791719370653,
      "link": null,
      "locked": false,
      "text": "# 执行过的工具与入参，用不着太长\ndef _shorten(value, limit: int = 200) -> str:\n\n# 拼装独立审核的内容：过去用户原文 + 过去执行的工具&入参 + 当前要执行的工具&入参\ndef build_transcript(messages, tool_name: str, args: dict) -> str:\n    lines = []\n    for message in messages:\n        for part in message.parts:\n            if part.part_kind == \"user-prompt\":\n                lines.append(json.dumps({\"user\": str(part.content)}, ensure_ascii=False))\n            elif part.part_kind == \"tool-call\":\n                call_args = {k: _shorten(v) for k, v in part.args_as_dict().items()}\n                lines.append(json.dumps({part.tool_name: call_args}, ensure_ascii=False))\n    pending = json.dumps(\n        {tool_name: {k: _shorten(v) for k, v in args.items()}}, ensure_ascii=False\n    )\n    if lines and lines[-1] == pending:\n        lines.pop()\n    lines.append(pending)\n    return \"\\n\".join(lines)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 执行过的工具与入参，用不着太长\ndef _shorten(value, limit: int = 200) -> str:\n\n# 拼装独立审核的内容：过去用户原文 + 过去执行的工具&入参 + 当前要执行的工具&入参\ndef build_transcript(messages, tool_name: str, args: dict) -> str:\n    lines = []\n    for message in messages:\n        for part in message.parts:\n            if part.part_kind == \"user-prompt\":\n                lines.append(json.dumps({\"user\": str(part.content)}, ensure_ascii=False))\n            elif part.part_kind == \"tool-call\":\n                call_args = {k: _shorten(v) for k, v in part.args_as_dict().items()}\n                lines.append(json.dumps({part.tool_name: call_args}, ensure_ascii=False))\n    pending = json.dumps(\n        {tool_name: {k: _shorten(v) for k, v in args.items()}}, ensure_ascii=False\n    )\n    if lines and lines[-1] == pending:\n        lines.pop()\n    lines.append(pending)\n    return \"\\n\".join(lines)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NvfDRyq2gQcslGONqR--v",
      "type": "text",
      "x": -4121.6388888889105,
