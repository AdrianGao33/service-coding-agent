    {
      "id": "pNFlPNwHv2ddz_cvbYrCH",
      "type": "text",
      "x": 2413.1111111111118,
      "y": 1271.7222222222222,
      "width": 492.79931640625,
      "height": 420,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0O",
      "roundness": null,
      "seed": 1813626901,
      "version": 1064,
      "versionNonce": 1004812283,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791573966786,
      "link": null,
      "locked": false,
      "text": "# 1. 文件路径 -> 特殊文件名\ndef sanitize_path(path: str) -> str:\n    return re.sub(r\"[^a-zA-Z0-9]\", \"-\", path) \n\n# 2. 获取当前项目专属的持久化存储目录\ndef project_dir() -> Path:\n    return STORAGE_ROOT / sanitize_path(str(Path.cwd()))\n\n# 3. 拼接出具体某次会话的 .jsonl 文件完整路径\ndef session_file(session_id: str) -> Path:\n    return project_dir() / f\"{session_id}.jsonl\"\n\n# 4. 提取会话总结（为list_sessions提供菜单行展示文本）\ndef first_prompt(path: Path) -> str:\n    with open(path, encoding=\"utf-8\") as f:\n        head = f.readline()\n    msg = json.loads(head)\n    for part in msg.get(\"parts\", []):\n        if part.get(\"part_kind\") == \"user-prompt\":\n            return str(part.get(\"content\", \"\"))\n    return \"(空会话)\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. 文件路径 -> 特殊文件名\ndef sanitize_path(path: str) -> str:\n    return re.sub(r\"[^a-zA-Z0-9]\", \"-\", path) \n\n# 2. 获取当前项目专属的持久化存储目录\ndef project_dir() -> Path:\n    return STORAGE_ROOT / sanitize_path(str(Path.cwd()))\n\n# 3. 拼接出具体某次会话的 .jsonl 文件完整路径\ndef session_file(session_id: str) -> Path:\n    return project_dir() / f\"{session_id}.jsonl\"\n\n# 4. 提取会话总结（为list_sessions提供菜单行展示文本）\ndef first_prompt(path: Path) -> str:\n    with open(path, encoding=\"utf-8\") as f:\n        head = f.readline()\n    msg = json.loads(head)\n    for part in msg.get(\"parts\", []):\n        if part.get(\"part_kind\") == \"user-prompt\":\n            return str(part.get(\"content\", \"\"))\n    return \"(空会话)\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jvoHd0RUx_byaf67AMo-W",
      "type": "text",
      "x": 1618.1111111111122,
      "y": 1216.7222222222226,
      "width": 730.3989868164062,
      "height": 660,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0Q",
      "roundness": null,
      "seed": 62544053,
      "version": 1071,
      "versionNonce": 1815183515,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "PIoa-Orm-fxz_6XV0yuSE",
          "type": "arrow"
        }
      ],
      "updated": 1791573966786,
      "link": null,
      "locked": false,
      "text": "# 1. 提供session id 给 main 调用\ndef new_session_id() -> str:\n    return str(uuid.uuid4())\n\n# 2. add / 更新本轮对话，追加一条json在jsonl文件\ndef append_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")\n\n# 3. list / 提供会话菜单 \ndef list_sessions() -> list:\n    if not project_dir().exists():\n        return []\n    files = sorted(\n        project_dir().glob(\"*.jsonl\"),\n        key=lambda p: p.stat().st_mtime,\n        reverse=True,\n    )\n    return [\n        (p.stem, datetime.fromtimestamp(p.stat().st_mtime), first_prompt(p))\n        for p in files\n    ]\n\n# 4. load by id / 提取某个session的jsonl\ndef load_history(session_id: str) -> list:\n    lines = session_file(session_id).read_text(encoding=\"utf-8\").splitlines()\n\n    return ModelMessagesTypeAdapter.validate_python(\n        [json.loads(line) for line in lines]\n    )",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. 提供session id 给 main 调用\ndef new_session_id() -> str:\n    return str(uuid.uuid4())\n\n# 2. add / 更新本轮对话，追加一条json在jsonl文件\ndef append_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")\n\n# 3. list / 提供会话菜单 \ndef list_sessions() -> list:\n    if not project_dir().exists():\n        return []\n    files = sorted(\n        project_dir().glob(\"*.jsonl\"),\n        key=lambda p: p.stat().st_mtime,\n        reverse=True,\n    )\n    return [\n        (p.stem, datetime.fromtimestamp(p.stat().st_mtime), first_prompt(p))\n        for p in files\n    ]\n\n# 4. load by id / 提取某个session的jsonl\ndef load_history(session_id: str) -> list:\n    lines = session_file(session_id).read_text(encoding=\"utf-8\").splitlines()\n\n    return ModelMessagesTypeAdapter.validate_python(\n        [json.loads(line) for line in lines]\n    )",
      "autoResize": true,
      "lineHeight": 1.25
    },
