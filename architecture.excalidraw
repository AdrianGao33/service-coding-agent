      "updated": 1792612135162,
      "link": null,
      "locked": false,
      "text": "def _dream_due(current_session_id: str) -> bool:\n    lock = _lock_path()\n    last = lock.stat().st_mtime if lock.exists() else 0.0\n    if time.time() - last < DREAM_MIN_HOURS * 3600:\n        return False\n    if not session.project_dir().exists():\n        return False\n    touched = [\n        p for p in session.project_dir().glob(\"*.jsonl\")\n        if p.stem != current_session_id and p.stat().st_mtime > last\n    ]\n    return len(touched) >= DREAM_MIN_SESSIONS",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def _dream_due(current_session_id: str) -> bool:\n    lock = _lock_path()\n    last = lock.stat().st_mtime if lock.exists() else 0.0\n    if time.time() - last < DREAM_MIN_HOURS * 3600:\n        return False\n    if not session.project_dir().exists():\n        return False\n    touched = [\n        p for p in session.project_dir().glob(\"*.jsonl\")\n        if p.stem != current_session_id and p.stat().st_mtime > last\n    ]\n    return len(touched) >= DREAM_MIN_SESSIONS",
      "autoResize": true,
      "lineHeight": 1.25
    },
