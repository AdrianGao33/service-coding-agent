      "updated": 1792613054437,
      "link": null,
      "locked": false,
      "text": "def schedule(state, new_messages) -> None:\n    if any(not t.done() for t in _background_tasks):\n        return\n    task = asyncio.create_task(\n        _run_background(list(state.history), list(new_messages), state.session_id)\n    )\n    _background_tasks.add(task)\n    task.add_done_callback(_background_tasks.discard) ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def schedule(state, new_messages) -> None:\n    if any(not t.done() for t in _background_tasks):\n        return\n    task = asyncio.create_task(\n        _run_background(list(state.history), list(new_messages), state.session_id)\n    )\n    _background_tasks.add(task)\n    task.add_done_callback(_background_tasks.discard) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
