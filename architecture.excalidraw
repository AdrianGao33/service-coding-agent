      "updated": 1792004599372,
      "link": null,
      "locked": false,
      "text": "READONLY_COMMANDS = {...白名单命令...}\n\nSHELL_META = re.compile(r\"[;&|<>`$\\n]\") #重定向黑名单操作符\n\ndef is_readonly_command(command: str) -> bool:\n    if SHELL_META.search(command): \n        return False\n    try: \n        tokens = shlex.split(command)\n    except ValueError:\n        return False\n    return bool(tokens) and tokens[0] in READONLY_COMMANDS",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "READONLY_COMMANDS = {...白名单命令...}\n\nSHELL_META = re.compile(r\"[;&|<>`$\\n]\") #重定向黑名单操作符\n\ndef is_readonly_command(command: str) -> bool:\n    if SHELL_META.search(command): \n        return False\n    try: \n        tokens = shlex.split(command)\n    except ValueError:\n        return False\n    return bool(tokens) and tokens[0] in READONLY_COMMANDS",
      "autoResize": true,
      "lineHeight": 1.25
    },
