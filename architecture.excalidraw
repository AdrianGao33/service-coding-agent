      "text": "_SUMMARY_FIELDS = (\"id\", \"subject\", \"status\", \"blocked_by\")\n\ndef task_list(ctx: RunContext[AgentDeps]) -> list[dict]:\n    return [{k: asdict(t)[k] for k in _SUMMARY_FIELDS} for t in ctx.deps.tasks_store.list()]",
