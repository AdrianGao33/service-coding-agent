      "text": "def _manifest_section() -> str:\n    headers = store.scan_memory_files()\n    if not headers:\n        return \"\"\n    return (\n        \"\\n## 现有记忆文件\\n\\n\"\n        + store.format_manifest(headers)\n        + \"\\n\\n写之前先对照这份清单——更新已有文件，而不是新建重复的。\"\n    )",
