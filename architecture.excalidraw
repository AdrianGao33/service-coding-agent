      "text": "def run_command(command: str) -> str:\n    try:\n        result = subprocess.run(\n            command\n        ....配置参数....\n        )\n        output = result.stdout\n        if result.returncode != 0:\n            output += f\"\\n[错误] {result.stderr}\"\n        return output or \"(无输出)\"\n    ... 放错excepts\\returns...",
