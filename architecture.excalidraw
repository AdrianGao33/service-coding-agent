      "link": null,
      "locked": false,
      "text": "\ndef is_readonly_command(command: str) -> bool:\n    if SHELL_META.search(command): \n        return False\n    try: \n        tokens = shlex.split(command)\n    except ValueError:\n        return False\n    return bool(tokens) and tokens[0] in READONLY_COMMANDS",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\ndef is_readonly_command(command: str) -> bool:\n    if SHELL_META.search(command): \n        return False\n    try: \n        tokens = shlex.split(command)\n    except ValueError:\n        return False\n    return bool(tokens) and tokens[0] in READONLY_COMMANDS",
      "autoResize": true,
      "lineHeight": 1.25
    },
