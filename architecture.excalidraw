      "updated": 1792612135162,
      "link": null,
      "locked": false,
      "text": "def truncate_content(content: str, max_lines: int, max_bytes: int, notice: str) -> str:\n    lines = content.splitlines()\n    truncated = False\n    if len(lines) > max_lines:\n        lines = lines[:max_lines]\n        truncated = True\n    text = \"\\n\".join(lines)\n    if len(text.encode(\"utf-8\")) > max_bytes:\n        text = text.encode(\"utf-8\")[:max_bytes].decode(\"utf-8\", errors=\"ignore\")\n        if \"\\n\" in text:\n            text = text[: text.rfind(\"\\n\")]\n        truncated = True\n    if truncated:\n        text += f\"\\n\\n> {notice}\"\n    return text",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def truncate_content(content: str, max_lines: int, max_bytes: int, notice: str) -> str:\n    lines = content.splitlines()\n    truncated = False\n    if len(lines) > max_lines:\n        lines = lines[:max_lines]\n        truncated = True\n    text = \"\\n\".join(lines)\n    if len(text.encode(\"utf-8\")) > max_bytes:\n        text = text.encode(\"utf-8\")[:max_bytes].decode(\"utf-8\", errors=\"ignore\")\n        if \"\\n\" in text:\n            text = text[: text.rfind(\"\\n\")]\n        truncated = True\n    if truncated:\n        text += f\"\\n\\n> {notice}\"\n    return text",
      "autoResize": true,
      "lineHeight": 1.25
    },
