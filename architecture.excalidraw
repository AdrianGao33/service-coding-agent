      "updated": 1792320601497,
      "link": null,
      "locked": false,
      "text": "\ndef _json_paths(self) -> Iterator[Path]:\n    for path in self.dir.iterdir():\n        if path.suffix == \".json\" and not path.name.startswith(\".\"):\n            yield path\n\ndef _task_path(self, task_id: str) -> Path:\n    return self.dir / f\"{task_id}.json\"\n\ndef _highwatermark_path(self) -> Path:\n    return self.dir / _HIGHWATERMARK\n\ndef _read_highwatermark(self) -> int:\n    path = self._highwatermark_path()\n    if not path.exists():\n        return 0\n    try:\n        return int(path.read_text(encoding=\"utf-8\").strip())\n    except (OSError, ValueError):\n        return 0\n\ndef _write_highwatermark(self, value: int) -> None:  #文件eg：.highwatermark\n    self._highwatermark_path().write_text(str(value), encoding=\"utf-8\")\n\ndef _write(self, task: Task) -> None:       #文件eg：1.json , 2.json\n    self._task_path(task.id).write_text(\n        json.dumps(asdict(task), ensure_ascii=False, indent=2),\n        encoding=\"utf-8\",\n    )",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\ndef _json_paths(self) -> Iterator[Path]:\n    for path in self.dir.iterdir():\n        if path.suffix == \".json\" and not path.name.startswith(\".\"):\n            yield path\n\ndef _task_path(self, task_id: str) -> Path:\n    return self.dir / f\"{task_id}.json\"\n\ndef _highwatermark_path(self) -> Path:\n    return self.dir / _HIGHWATERMARK\n\ndef _read_highwatermark(self) -> int:\n    path = self._highwatermark_path()\n    if not path.exists():\n        return 0\n    try:\n        return int(path.read_text(encoding=\"utf-8\").strip())\n    except (OSError, ValueError):\n        return 0\n\ndef _write_highwatermark(self, value: int) -> None:  #文件eg：.highwatermark\n    self._highwatermark_path().write_text(str(value), encoding=\"utf-8\")\n\ndef _write(self, task: Task) -> None:       #文件eg：1.json , 2.json\n    self._task_path(task.id).write_text(\n        json.dumps(asdict(task), ensure_ascii=False, indent=2),\n        encoding=\"utf-8\",\n    )",
      "autoResize": true,
      "lineHeight": 1.25
    },
