      "locked": false,
      "text": "def _background_notice(job, lead: str) -> str:\n    return (\n        f\"{lead}\\n\"\n        f\"输出日志：{job.log_path}（随时可用 read_file 查看）\\n\"\n        \"完成后你会收到 <task-notification> 通知，不要原地等待。\"\n    )",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def _background_notice(job, lead: str) -> str:\n    return (\n        f\"{lead}\\n\"\n        f\"输出日志：{job.log_path}（随时可用 read_file 查看）\\n\"\n        \"完成后你会收到 <task-notification> 通知，不要原地等待。\"\n    )",
      "autoResize": true,
      "lineHeight": 1.25
    },
