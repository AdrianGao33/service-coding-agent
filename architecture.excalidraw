      "link": null,
      "locked": false,
      "text": "async def drain(timeout: float = 60) -> None:\n    tasks = [t for t in _background_tasks if not t.done()]\n    if not tasks:\n        return\n    print_step(\"[dim]◇ memory[/]\", \"[dim]等待后台记忆任务收尾（Ctrl+C 强退）...[/]\")\n    await asyncio.wait(tasks, timeout=timeout)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def drain(timeout: float = 60) -> None:\n    tasks = [t for t in _background_tasks if not t.done()]\n    if not tasks:\n        return\n    print_step(\"[dim]◇ memory[/]\", \"[dim]等待后台记忆任务收尾（Ctrl+C 强退）...[/]\")\n    await asyncio.wait(tasks, timeout=timeout)",
      "autoResize": true,
      "lineHeight": 1.25
    },
