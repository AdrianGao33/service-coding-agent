      "boundElements": [],
      "updated": 1792612073536,
      "link": null,
      "locked": false,
      "text": "SessionState/对话状态： \n1. 创建：记录当下对话的上下文信息（class在commands.py中声明, 但是main.py的main()里实例化的）\n2. 内容：   1. history: list = field(default_factory=list)         # 全量上下文消息历史\n              2. input_tokens: int = 0                                # 本session流入大模型的token累积量\n              3. output_tokens: int = 0                              # 本session大模型输出的token累积量\n              4. model_name: str = \"\"\n              5. session_id: str = \"\"                                   # 当前会话 ID（决定写入哪个 jsonl 文件）  \n              6. last_api_calls: list = field(default_factory=list)    # 最近一轮对话触发的 API 调用日志\n              7. read_file_state: ReadFileState = field(default_factory=ReadFileState)    # 本会话的 readFileState\n              8. tasks_store: TasksStore | None = None      # 本会话的 TasksStore，落盘在 ~/.my-code-agent/tasks/<session_id>/\n              9. surfaced_memories: set                          # 本会话已注入的文件名，resume会清空，需要重新再判断召回\n3. 传递：作为参数显式传给 run_agent_loop(user_input, state) ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "SessionState/对话状态： \n1. 创建：记录当下对话的上下文信息（class在commands.py中声明, 但是main.py的main()里实例化的）\n2. 内容：   1. history: list = field(default_factory=list)         # 全量上下文消息历史\n              2. input_tokens: int = 0                                # 本session流入大模型的token累积量\n              3. output_tokens: int = 0                              # 本session大模型输出的token累积量\n              4. model_name: str = \"\"\n              5. session_id: str = \"\"                                   # 当前会话 ID（决定写入哪个 jsonl 文件）  \n              6. last_api_calls: list = field(default_factory=list)    # 最近一轮对话触发的 API 调用日志\n              7. read_file_state: ReadFileState = field(default_factory=ReadFileState)    # 本会话的 readFileState\n              8. tasks_store: TasksStore | None = None      # 本会话的 TasksStore，落盘在 ~/.my-code-agent/tasks/<session_id>/\n              9. surfaced_memories: set                          # 本会话已注入的文件名，resume会清空，需要重新再判断召回\n3. 传递：作为参数显式传给 run_agent_loop(user_input, state) ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "wsIxcOA9A8z24a8kE40pW",
