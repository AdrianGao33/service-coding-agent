      "text": "async def _watch(self, job: Job, proc: asyncio.subprocess.Process, log_file) -> None:\n    returncode = await proc.wait()\n    log_file.close()\n    if job.status == \"killed\":\n        return\n    job.returncode = returncode\n    job.status = \"completed\" if returncode == 0 else \"failed\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def _watch(self, job: Job, proc: asyncio.subprocess.Process, log_file) -> None:\n    returncode = await proc.wait()\n    log_file.close()\n    if job.status == \"killed\":\n        return\n    job.returncode = returncode\n    job.status = \"completed\" if returncode == 0 else \"failed\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
