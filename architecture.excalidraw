      "text": "def inject_at_mentions(user_input, state):\n    paths = extract_at_mentions(user_input) \n    if not paths:\n        return\n    mention_messages = build_mention_messages(paths, state.read_file_state)\n    if not mention_messages:\n        return\n    state.history += mention_messages \n    session.append_messages(state.session_id, mention_messages)\n    for msg in mention_messages:\n        for part in msg.parts:\n            print_part(part)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def inject_at_mentions(user_input, state):\n    paths = extract_at_mentions(user_input) \n    if not paths:\n        return\n    mention_messages = build_mention_messages(paths, state.read_file_state)\n    if not mention_messages:\n        return\n    state.history += mention_messages \n    session.append_messages(state.session_id, mention_messages)\n    for msg in mention_messages:\n        for part in msg.parts:\n            print_part(part)",
      "autoResize": true,
      "lineHeight": 1.25
    },
