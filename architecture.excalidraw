      "link": null,
      "locked": false,
      "text": "def task_get(ctx: RunContext[AgentDeps], task_id: str) -> dict:\n    task = ctx.deps.tasks_store.get(task_id)\n    if task is None:\n        raise ModelRetry(f\"task #{task_id} 不存在，可以先 task_list 看看现在有哪些 task\")\n    return asdict(task)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def task_get(ctx: RunContext[AgentDeps], task_id: str) -> dict:\n    task = ctx.deps.tasks_store.get(task_id)\n    if task is None:\n        raise ModelRetry(f\"task #{task_id} 不存在，可以先 task_list 看看现在有哪些 task\")\n    return asdict(task)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-vF9VVOFr8TRE18acX-ge",
