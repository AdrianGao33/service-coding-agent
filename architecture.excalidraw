      "updated": 1792553503757,
      "link": null,
      "locked": false,
      "text": "1. 请求前hook：@hooks.on.before_model_request\n2. 请求后hook：@hooks.on.after_model_request\n3. 工具执行hook：@hooks.on.tool_execute\n4. 请求报错hook：@hooks.on.model_request\n5. 工具执行报错hook：@hooks.on.tool_execute_error",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 请求前hook：@hooks.on.before_model_request\n2. 请求后hook：@hooks.on.after_model_request\n3. 工具执行hook：@hooks.on.tool_execute\n4. 请求报错hook：@hooks.on.model_request\n5. 工具执行报错hook：@hooks.on.tool_execute_error",
      "autoResize": true,
      "lineHeight": 1.25
    },
