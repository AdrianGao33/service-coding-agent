      "link": null,
      "locked": false,
      "text": "def run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    if is_readonly_command(command):\n        return \"allow\"\n    return None",
      "fontSize": 16.161159640307808,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    if is_readonly_command(command):\n        return \"allow\"\n    return None",
      "autoResize": true,
      "lineHeight": 1.25
    },
