      "updated": 1792004599372,
      "link": null,
      "locked": false,
      "text": "def edit_file(ctx: RunContext[ReadFileState], path: str, old_string: str, new_string: str, replace_all: bool = False) -> str:\n    ... old_string、new_string 检查，时间检查，不唯一检查，未读检查...\n    if replace_all:\n        updated = content.replace(old_string, new_string)\n    else:\n        updated = content.replace(old_string, new_string, 1) # 如果多个有重复，只替换遇见的第一个\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(updated)\n    ctx.deps.record(path, updated)\n    return f\"已编辑 {path}（替换 {count if replace_all else 1} 处）\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def edit_file(ctx: RunContext[ReadFileState], path: str, old_string: str, new_string: str, replace_all: bool = False) -> str:\n    ... old_string、new_string 检查，时间检查，不唯一检查，未读检查...\n    if replace_all:\n        updated = content.replace(old_string, new_string)\n    else:\n        updated = content.replace(old_string, new_string, 1) # 如果多个有重复，只替换遇见的第一个\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(updated)\n    ctx.deps.record(path, updated)\n    return f\"已编辑 {path}（替换 {count if replace_all else 1} 处）\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
