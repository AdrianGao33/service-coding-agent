      "locked": false,
      "text": "def is_memory_path(path: str) -> bool:\n    if not path:\n        return False\n    try:\n        return Path(path).resolve().is_relative_to(memory_dir().resolve())\n    except (OSError, ValueError):\n        return False",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def is_memory_path(path: str) -> bool:\n    if not path:\n        return False\n    try:\n        return Path(path).resolve().is_relative_to(memory_dir().resolve())\n    except (OSError, ValueError):\n        return False",
      "autoResize": true,
      "lineHeight": 1.25
    },
