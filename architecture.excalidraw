      "link": null,
      "locked": false,
      "text": "def edit_file(ctx: RunContext[AgentDeps], path: str, old_string: str, new_string: str, replace_all: bool = False) -> str:\n    \n\n    \n    state = ctx.deps.read_file_state\n    if replace_all:\n        updated = content.replace(old_string, new_string)\n    else:\n        updated = content.replace(old_string, new_string, 1) \n    \n    if ctx.deps.file_history:\n        ctx.deps.file_history.track_edit(path)\n    \n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(updated)\n    state.record(path, updated)\n    return f\"已编辑 {path}（替换 {count if replace_all else 1} 处）\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def edit_file(ctx: RunContext[AgentDeps], path: str, old_string: str, new_string: str, replace_all: bool = False) -> str:\n    \n\n    \n    state = ctx.deps.read_file_state\n    if replace_all:\n        updated = content.replace(old_string, new_string)\n    else:\n        updated = content.replace(old_string, new_string, 1) \n    \n    if ctx.deps.file_history:\n        ctx.deps.file_history.track_edit(path)\n    \n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        f.write(updated)\n    state.record(path, updated)\n    return f\"已编辑 {path}（替换 {count if replace_all else 1} 处）\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
