      "updated": 1793381176954,
      "link": null,
      "locked": false,
      "text": "# 1. 文件路径 -> 特殊文件名\ndef sanitize_path(path: str) -> str:\n    return re.sub(r\"[^a-zA-Z0-9]\", \"-\", path) \n\n# 2. 获取当前项目专属的持久化存储目录\ndef project_dir() -> Path:\n    return STORAGE_ROOT / sanitize_path(str(Path.cwd()))\n\n# 3. 拼接出具体某次会话的 .jsonl 文件完整路径\ndef session_file(session_id: str) -> Path:\n    return project_dir() / f\"{session_id}.jsonl\"\n\n# 4. 提取会话总结（为list_sessions提供菜单行展示文本）\nwith open(path, encoding=\"utf-8\") as f:\n    for _ in range(20):\n        line = f.readline()\n        if not line:\n            break\n        msg = json.loads(line)\n        for part in msg.get(\"parts\", []):\n            if part.get(\"part_kind\") != \"user-prompt\":\n                continue\n            content = str(part.get(\"content\", \"\"))\n            if content.startswith(\"<system-reminder>\"):\n                continue\n            return content\nreturn \"(空会话)\"\n\n# 5. 从文件开头找到首条真正的用户输入，作为这个会话的摘要\ndef first_prompt(path: Path) -> str:\n    with open(path, encoding=\"utf-8\") as f:\n        for _ in range(20):\n            line = f.readline()\n            if not line:\n                break\n            msg = json.loads(line)\n            for part in msg.get(\"parts\", []):\n                if part.get(\"part_kind\") != \"user-prompt\":\n                    continue\n                content = str(part.get(\"content\", \"\"))\n                if content.startswith((\n                    \"<system-reminder>\", \n                    \"<task-notification>\",\n                )):\n                    continue\n                return content\n    return \"(空会话)\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. 文件路径 -> 特殊文件名\ndef sanitize_path(path: str) -> str:\n    return re.sub(r\"[^a-zA-Z0-9]\", \"-\", path) \n\n# 2. 获取当前项目专属的持久化存储目录\ndef project_dir() -> Path:\n    return STORAGE_ROOT / sanitize_path(str(Path.cwd()))\n\n# 3. 拼接出具体某次会话的 .jsonl 文件完整路径\ndef session_file(session_id: str) -> Path:\n    return project_dir() / f\"{session_id}.jsonl\"\n\n# 4. 提取会话总结（为list_sessions提供菜单行展示文本）\nwith open(path, encoding=\"utf-8\") as f:\n    for _ in range(20):\n        line = f.readline()\n        if not line:\n            break\n        msg = json.loads(line)\n        for part in msg.get(\"parts\", []):\n            if part.get(\"part_kind\") != \"user-prompt\":\n                continue\n            content = str(part.get(\"content\", \"\"))\n            if content.startswith(\"<system-reminder>\"):\n                continue\n            return content\nreturn \"(空会话)\"\n\n# 5. 从文件开头找到首条真正的用户输入，作为这个会话的摘要\ndef first_prompt(path: Path) -> str:\n    with open(path, encoding=\"utf-8\") as f:\n        for _ in range(20):\n            line = f.readline()\n            if not line:\n                break\n            msg = json.loads(line)\n            for part in msg.get(\"parts\", []):\n                if part.get(\"part_kind\") != \"user-prompt\":\n                    continue\n                content = str(part.get(\"content\", \"\"))\n                if content.startswith((\n                    \"<system-reminder>\", \n                    \"<task-notification>\",\n                )):\n                    continue\n                return content\n    return \"(空会话)\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jvoHd0RUx_byaf67AMo-W",
      "type": "text",
      "x": -5191.840668746545,
      "y": -4534.8551626652215,
      "width": 730.3989868164062,
      "height": 960,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VMtGU08fn6eLLwyEtiMiK",
        "nW96WGxJPr5YmEMrnFVxM",
        "p9uDDagU6LrlKAf8EC6ch"
      ],
      "frameId": null,
      "index": "bBqG",
      "roundness": null,
      "seed": 62544053,
      "version": 4338,
      "versionNonce": 1776927310,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "OfzrETTszC35yRU4zo4tI",
          "type": "arrow"
        }
      ],
      "updated": 1793381176954,
      "link": null,
      "locked": false,
      "text": "# 1. 提供session id 给 main 调用\ndef new_session_id() -> str:\n    return str(uuid.uuid4())\n\n# 2. list / 提供会话菜单 \ndef list_sessions() -> list:\n    if not project_dir().exists():\n        return []\n    files = sorted(\n        project_dir().glob(\"*.jsonl\"),\n        key=lambda p: p.stat().st_mtime,\n        reverse=True,\n    )\n    return [\n        (p.stem, datetime.fromtimestamp(p.stat().st_mtime), first_prompt(p))\n        for p in files\n    ]\n\n# 3. load by id / 提取某个session的jsonl\ndef load_history(session_id: str) -> list:\n    lines = session_file(session_id).read_text(encoding=\"utf-8\").splitlines()\n\n    return ModelMessagesTypeAdapter.validate_python(\n        [json.loads(line) for line in lines]\n    )\n\n# 4. 用内存里的对话历史重写/覆盖会话文件\ndef rewrite_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")\n\n# 5. 压缩前，把会话文件转移到compact-history单独隔离+备份\ndef archive_session(session_id: str) -> Path:\n    archive_dir = project_dir() / \"compact-history\"\n    archive_dir.mkdir(parents=True, exist_ok=True)\n    path = archive_dir / f\"{session_id}-{datetime.now():%Y%m%d-%H%M%S}.jsonl\"\n    shutil.copy2(session_file(session_id), path)\n    return path\n\ndef append_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. 提供session id 给 main 调用\ndef new_session_id() -> str:\n    return str(uuid.uuid4())\n\n# 2. list / 提供会话菜单 \ndef list_sessions() -> list:\n    if not project_dir().exists():\n        return []\n    files = sorted(\n        project_dir().glob(\"*.jsonl\"),\n        key=lambda p: p.stat().st_mtime,\n        reverse=True,\n    )\n    return [\n        (p.stem, datetime.fromtimestamp(p.stat().st_mtime), first_prompt(p))\n        for p in files\n    ]\n\n# 3. load by id / 提取某个session的jsonl\ndef load_history(session_id: str) -> list:\n    lines = session_file(session_id).read_text(encoding=\"utf-8\").splitlines()\n\n    return ModelMessagesTypeAdapter.validate_python(\n        [json.loads(line) for line in lines]\n    )\n\n# 4. 用内存里的对话历史重写/覆盖会话文件\ndef rewrite_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"w\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")\n\n# 5. 压缩前，把会话文件转移到compact-history单独隔离+备份\ndef archive_session(session_id: str) -> Path:\n    archive_dir = project_dir() / \"compact-history\"\n    archive_dir.mkdir(parents=True, exist_ok=True)\n    path = archive_dir / f\"{session_id}-{datetime.now():%Y%m%d-%H%M%S}.jsonl\"\n    shutil.copy2(session_file(session_id), path)\n    return path\n\ndef append_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")",
      "autoResize": true,
      "lineHeight": 1.25
    },
