      "text": "async def _run_background(history: list, new_messages: list, session_id: str) -> None:\n    try:\n        if not store.has_memory_writes(new_messages): \n            await _extract(history)                    \n        await dream(history, session_id=session_id)    \n    except Exception as e:\n        print_step(\"[yellow]⚠ memory[/]\", f\"[yellow]后台记忆任务出错：{type(e).__name__}: {e}[/]\")",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def _run_background(history: list, new_messages: list, session_id: str) -> None:\n    try:\n        if not store.has_memory_writes(new_messages): \n            await _extract(history)                    \n        await dream(history, session_id=session_id)    \n    except Exception as e:\n        print_step(\"[yellow]⚠ memory[/]\", f\"[yellow]后台记忆任务出错：{type(e).__name__}: {e}[/]\")",
      "autoResize": true,
      "lineHeight": 1.25
    },
