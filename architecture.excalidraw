      "updated": 1793188911010,
      "link": null,
      "locked": false,
      "text": "def load_servers() -> None:\n    merged: dict[str, Any] = {}\n\n    for config_path in (USER_CONFIG, PROJECT_CONFIG):\n        if not config_path.is_file():\n            continue\n        \n        try:\n            toolsets = list(load_mcp_toolsets(config_path))\n        except TypeError:\n            toolsets = list(load_mcp_toolsets(str(config_path)))\n\n        for toolset in toolsets:\n            toolset = _normalize_toolset(toolset)\n            merged[_toolset_id(toolset)] = toolset  \n\n    # 刷新全局记录列表\n    RECORDS.clear()\n    RECORDS.extend(    \n        ServerRecord(\n            toolset=toolset,\n            transport=_transport(toolset),\n            toolset_id=_toolset_id(toolset),\n        )\n        for toolset in merged.values() \n    )\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def load_servers() -> None:\n    merged: dict[str, Any] = {}\n\n    for config_path in (USER_CONFIG, PROJECT_CONFIG):\n        if not config_path.is_file():\n            continue\n        \n        try:\n            toolsets = list(load_mcp_toolsets(config_path))\n        except TypeError:\n            toolsets = list(load_mcp_toolsets(str(config_path)))\n\n        for toolset in toolsets:\n            toolset = _normalize_toolset(toolset)\n            merged[_toolset_id(toolset)] = toolset  \n\n    # 刷新全局记录列表\n    RECORDS.clear()\n    RECORDS.extend(    \n        ServerRecord(\n            toolset=toolset,\n            transport=_transport(toolset),\n            toolset_id=_toolset_id(toolset),\n        )\n        for toolset in merged.values() \n    )\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
