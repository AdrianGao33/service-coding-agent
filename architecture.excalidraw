      "updated": 1793188911010,
      "link": null,
      "locked": false,
      "text": "async def _connect(record: ServerRecord) -> None:    \n    try:\n        await _stack.enter_async_context(record.toolset)\n        record.status = \"connected\"\n        record.tool_names = []         #运行时才按需加载工具\n    except Exception as e:\n        while getattr(e, \"exceptions\", None):\n            e = e.exceptions[0]\n        record.status = \"failed\"\n        record.error = f\"{type(e).__name__}: {e}\" if str(e) else type(e).__name__",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def _connect(record: ServerRecord) -> None:    \n    try:\n        await _stack.enter_async_context(record.toolset)\n        record.status = \"connected\"\n        record.tool_names = []         #运行时才按需加载工具\n    except Exception as e:\n        while getattr(e, \"exceptions\", None):\n            e = e.exceptions[0]\n        record.status = \"failed\"\n        record.error = f\"{type(e).__name__}: {e}\" if str(e) else type(e).__name__",
      "autoResize": true,
      "lineHeight": 1.25
    },
