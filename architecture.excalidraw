      "seed": 1813626901,
      "version": 2351,
      "versionNonce": 1373879561,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792611789192,
      "link": null,
      "locked": false,
      "text": "# 1. 文件路径 -> 特殊文件名\ndef sanitize_path(path: str) -> str:\n    return re.sub(r\"[^a-zA-Z0-9]\", \"-\", path) \n\n# 2. 获取当前项目专属的持久化存储目录\ndef project_dir() -> Path:\n    return STORAGE_ROOT / sanitize_path(str(Path.cwd()))\n\n# 3. 拼接出具体某次会话的 .jsonl 文件完整路径\ndef session_file(session_id: str) -> Path:\n    return project_dir() / f\"{session_id}.jsonl\"\n\n# 4. 提取会话总结（为list_sessions提供菜单行展示文本）\nwith open(path, encoding=\"utf-8\") as f:\n    for _ in range(20):\n        line = f.readline()\n        if not line:\n            break\n        msg = json.loads(line)\n        for part in msg.get(\"parts\", []):\n            if part.get(\"part_kind\") != \"user-prompt\":\n                continue\n            content = str(part.get(\"content\", \"\"))\n            if content.startswith(\"<system-reminder>\"):\n                continue\n            return content\nreturn \"(空会话)\"\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. 文件路径 -> 特殊文件名\ndef sanitize_path(path: str) -> str:\n    return re.sub(r\"[^a-zA-Z0-9]\", \"-\", path) \n\n# 2. 获取当前项目专属的持久化存储目录\ndef project_dir() -> Path:\n    return STORAGE_ROOT / sanitize_path(str(Path.cwd()))\n\n# 3. 拼接出具体某次会话的 .jsonl 文件完整路径\ndef session_file(session_id: str) -> Path:\n    return project_dir() / f\"{session_id}.jsonl\"\n\n# 4. 提取会话总结（为list_sessions提供菜单行展示文本）\nwith open(path, encoding=\"utf-8\") as f:\n    for _ in range(20):\n        line = f.readline()\n        if not line:\n            break\n        msg = json.loads(line)\n        for part in msg.get(\"parts\", []):\n            if part.get(\"part_kind\") != \"user-prompt\":\n                continue\n            content = str(part.get(\"content\", \"\"))\n            if content.startswith(\"<system-reminder>\"):\n                continue\n            return content\nreturn \"(空会话)\"\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "jvoHd0RUx_byaf67AMo-W",
      "type": "text",
      "x": -5385.793650793649,
      "y": -3638.087301587301,
      "width": 730.3989868164062,
      "height": 660,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
