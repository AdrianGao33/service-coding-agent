      "link": null,
      "locked": false,
      "text": "def extract_at_mentions(text: str) -> list[str]:\n    seen = [] \n    for match in AT_MENTION_RE.finditer(text):\n        path = match.group(1) #拿掉没用的@符号：group(0) 为 \" @abc.py\" ──► group(1) 为 \"abc.py\" \n        if path not in seen:\n            seen.append(path)\n    return seen",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def extract_at_mentions(text: str) -> list[str]:\n    seen = [] \n    for match in AT_MENTION_RE.finditer(text):\n        path = match.group(1) #拿掉没用的@符号：group(0) 为 \" @abc.py\" ──► group(1) 为 \"abc.py\" \n        if path not in seen:\n            seen.append(path)\n    return seen",
      "autoResize": true,
      "lineHeight": 1.25
    },
