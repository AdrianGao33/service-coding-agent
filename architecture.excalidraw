      "text": "def summary(self) -> str:\n    detail = _STATUS_TEXT[self.status] \n    if self.returncode is not None:\n        detail += f\"，exit code {self.returncode}\"\n    return f\"后台命令「{self.description}」{detail}\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
