      "text": "CONTEXT_WINDOW = 131_072         #1. 压缩对话单次上下文总上限：输入+输出\nCOMPACT_OUTPUT_RESERVE = 20_000  #2. 预留压缩模型输出空间 \nAUTO_COMPACT_BUFFER = 10_000     #3. 安全余量，用来警戒触发自动压缩\nMAX_COMPACT_FAILURES = 3         #4. 自动压缩连续失败3次，不再尝试，防熔断 \nRESTORE_MAX_FILES = 5            #5. 压缩后恢复预读文件最多5个\nRESTORE_MAX_CHARS = 30_000       #6. 最多恢复预读字符30000个\nCOMPACT_PROMPT = ...省略...      #7. 压缩提示词\nSUMMARY_WRAPPER = ...省略...     #8. 压缩结束后，首次承上启下提示词 ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CONTEXT_WINDOW = 131_072         #1. 压缩对话单次上下文总上限：输入+输出\nCOMPACT_OUTPUT_RESERVE = 20_000  #2. 预留压缩模型输出空间 \nAUTO_COMPACT_BUFFER = 10_000     #3. 安全余量，用来警戒触发自动压缩\nMAX_COMPACT_FAILURES = 3         #4. 自动压缩连续失败3次，不再尝试，防熔断 \nRESTORE_MAX_FILES = 5            #5. 压缩后恢复预读文件最多5个\nRESTORE_MAX_CHARS = 30_000       #6. 最多恢复预读字符30000个\nCOMPACT_PROMPT = ...省略...      #7. 压缩提示词\nSUMMARY_WRAPPER = ...省略...     #8. 压缩结束后，首次承上启下提示词 ",
      "autoResize": true,
      "lineHeight": 1.25
    },
