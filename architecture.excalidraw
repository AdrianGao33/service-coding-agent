      "text": "# 程序启动主函数：\nasync def main():\n    session_id = session.new_session_id()\n    \n    tasks_store = TasksStore(session_id=session_id)\n    state = SessionState(\n        model_name=MODEL_NAME,\n        session_id=session_id,\n        tasks_store=tasks_store,\n    )\n    print_welcome_banner(\"my-claude-code\")\n\n    repl = Repl(state)\n\n    async def on_submit(user_input):\n        action = await handle_command(user_input, state)\n        if action == \"break\":\n            repl.exit()\n            return\n        if action == \"continue\":\n            return\n        inject_at_mentions(user_input, state)\n        repl.start_working()\n        await run_agent_loop(user_input, state)\n\n    await repl.run(on_submit)\n\nif __name__ == \"__main__\":\n    try:\n        asyncio.run(main())\n    except (KeyboardInterrupt, EOFError):\n        pass ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 程序启动主函数：\nasync def main():\n    session_id = session.new_session_id()\n    \n    tasks_store = TasksStore(session_id=session_id)\n    state = SessionState(\n        model_name=MODEL_NAME,\n        session_id=session_id,\n        tasks_store=tasks_store,\n    )\n    print_welcome_banner(\"my-claude-code\")\n\n    repl = Repl(state)\n\n    async def on_submit(user_input):\n        action = await handle_command(user_input, state)\n        if action == \"break\":\n            repl.exit()\n            return\n        if action == \"continue\":\n            return\n        inject_at_mentions(user_input, state)\n        repl.start_working()\n        await run_agent_loop(user_input, state)\n\n    await repl.run(on_submit)\n\nif __name__ == \"__main__\":\n    try:\n        asyncio.run(main())\n    except (KeyboardInterrupt, EOFError):\n        pass ",
      "autoResize": true,
      "lineHeight": 1.25
    },
