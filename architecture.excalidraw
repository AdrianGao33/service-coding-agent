    {
      "id": "F46MEux1Z21Nsyr5h_IWO",
      "type": "text",
      "x": -1936.1891513400815,
      "y": -5126.934936752432,
      "width": 932.7987060546875,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "e8isTaZmoxx_Yhl5QkDWW"
      ],
      "frameId": null,
      "index": "b44V",
      "roundness": null,
