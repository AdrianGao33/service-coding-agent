      "updated": 1793378952184,
      "link": null,
      "locked": false,
      "text": "1. 请求前hook：@hooks.on.before_model_request\n2. 请求后hook：@hooks.on.after_model_request\n3. 工具执行hook：@hooks.on.tool_execute\n4. 请求时hook：@hooks.on.model_request\n5. 工具执行报错hook：@hooks.on.tool_execute_error",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 请求前hook：@hooks.on.before_model_request\n2. 请求后hook：@hooks.on.after_model_request\n3. 工具执行hook：@hooks.on.tool_execute\n4. 请求时hook：@hooks.on.model_request\n5. 工具执行报错hook：@hooks.on.tool_execute_error",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "RzmyTuyvLPywLfbhYWfcd",
      "type": "text",
      "x": -5663.0885463038585,
      "y": -3225.7209173023625,
      "width": 1018.3989868164062,
      "height": 320,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
