      "updated": 1792004599372,
      "link": null,
      "locked": false,
      "text": "DANGEROUS_PATTERNS = [...高危命令...]\n\n# 工具3的安全拦截函数，前置检查\ndef run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    if is_readonly_command(command):\n        return \"allow\"\n    return None",
      "fontSize": 16.161159640307808,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DANGEROUS_PATTERNS = [...高危命令...]\n\n# 工具3的安全拦截函数，前置检查\ndef run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    if is_readonly_command(command):\n        return \"allow\"\n    return None",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "vjBuuSX9bV9Wq2q0w12v-",
      "type": "text",
