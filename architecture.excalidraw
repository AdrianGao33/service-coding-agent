      "boundElements": null,
      "updated": 1793425424839,
      "link": null,
      "locked": false,
      "text": "def build_job_reminder_text(registry: JobRegistry | None) -> str | None:\n    if registry is None:\n        return None\n    jobs = registry.pop_unnotified()\n    if not jobs:\n        return None\n    blocks = []\n    for job in jobs:\n        color = \"green\" if job.status == \"completed\" else \"red\"\n        console.print(f\"[{color}]●[/] {escape(job.summary())}\\n\")\n        summary = f\"{job.summary()}，可用 read_file 读输出文件\"\n        blocks.append(\n            \"<task-notification>\\n\"\n            f\"<task-id>{job.id}</task-id>\\n\"\n            f\"<task-type>{job.kind}</task-type>\\n\"\n            f\"<output-file>{job.log_path}</output-file>\\n\"\n            f\"<status>{job.status}</status>\\n\"\n            f\"<summary>{summary}</summary>\\n\"\n            \"</task-notification>\"\n        )\n    return \"\\n\\n\".join(blocks)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def build_job_reminder_text(registry: JobRegistry | None) -> str | None:\n    if registry is None:\n        return None\n    jobs = registry.pop_unnotified()\n    if not jobs:\n        return None\n    blocks = []\n    for job in jobs:\n        color = \"green\" if job.status == \"completed\" else \"red\"\n        console.print(f\"[{color}]●[/] {escape(job.summary())}\\n\")\n        summary = f\"{job.summary()}，可用 read_file 读输出文件\"\n        blocks.append(\n            \"<task-notification>\\n\"\n            f\"<task-id>{job.id}</task-id>\\n\"\n            f\"<task-type>{job.kind}</task-type>\\n\"\n            f\"<output-file>{job.log_path}</output-file>\\n\"\n            f\"<status>{job.status}</status>\\n\"\n            f\"<summary>{summary}</summary>\\n\"\n            \"</task-notification>\"\n        )\n    return \"\\n\\n\".join(blocks)",
      "autoResize": true,
      "lineHeight": 1.25
    },
