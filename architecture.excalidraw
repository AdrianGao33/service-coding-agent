      "updated": 1791979269792,
      "link": null,
      "locked": false,
      "text": "# 1. 提供session id 给 main 调用\ndef new_session_id() -> str:\n    return str(uuid.uuid4())\n\n# 2. add / 更新本轮对话，追加一条json在jsonl文件\ndef append_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")\n\n# 3. list / 提供会话菜单 \ndef list_sessions() -> list:\n    if not project_dir().exists():\n        return []\n    files = sorted(\n        project_dir().glob(\"*.jsonl\"),\n        key=lambda p: p.stat().st_mtime,\n        reverse=True,\n    )\n    return [\n        (p.stem, datetime.fromtimestamp(p.stat().st_mtime), first_prompt(p))\n        for p in files\n    ]\n\n# 4. load by id / 提取某个session的jsonl\ndef load_history(session_id: str) -> list:\n    lines = session_file(session_id).read_text(encoding=\"utf-8\").splitlines()\n\n    return ModelMessagesTypeAdapter.validate_python(\n        [json.loads(line) for line in lines]\n    )",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 1. 提供session id 给 main 调用\ndef new_session_id() -> str:\n    return str(uuid.uuid4())\n\n# 2. add / 更新本轮对话，追加一条json在jsonl文件\ndef append_messages(session_id: str, messages) -> None:\n    path = session_file(session_id)\n    path.parent.mkdir(parents=True, exist_ok=True)\n    with open(path, \"a\", encoding=\"utf-8\") as f:\n        for msg in messages:\n            f.write(json.dumps(to_jsonable_python(msg), ensure_ascii=False) + \"\\n\")\n\n# 3. list / 提供会话菜单 \ndef list_sessions() -> list:\n    if not project_dir().exists():\n        return []\n    files = sorted(\n        project_dir().glob(\"*.jsonl\"),\n        key=lambda p: p.stat().st_mtime,\n        reverse=True,\n    )\n    return [\n        (p.stem, datetime.fromtimestamp(p.stat().st_mtime), first_prompt(p))\n        for p in files\n    ]\n\n# 4. load by id / 提取某个session的jsonl\ndef load_history(session_id: str) -> list:\n    lines = session_file(session_id).read_text(encoding=\"utf-8\").splitlines()\n\n    return ModelMessagesTypeAdapter.validate_python(\n        [json.loads(line) for line in lines]\n    )",
      "autoResize": true,
      "lineHeight": 1.25
    },
