      "updated": 1792614909696,
      "link": null,
      "locked": false,
      "text": "# 程序启动主函数：\nasync def main():\n    session_id = session.new_session_id()\n    store.ensure_memory_dir()\n    tasks_store = TasksStore(session_id=session_id)\n    state = SessionState(\n        model_name=MODEL_NAME,\n        session_id=session_id,\n        tasks_store=tasks_store,\n    )\n    print_welcome_banner(\"my-code-agent\")\n    repl = Repl(state)\n    async def on_submit(user_input):\n        action = await handle_command(user_input, state)\n        if action == \"break\":\n            repl.exit()\n            return\n        if action == \"continue\":\n            return\n        \n        inject_at_mentions(user_input, state)\n\n        repl.start_working()\n        \n        await recall.inject_memories(user_input, state)\n        \n        result = await run_agent_loop(user_input, state)\n\n        background.schedule(state, result.new_messages())\n    \n    await repl.run(on_submit)\n\n    await background.drain()\n\nif __name__ == \"__main__\":\n    try:\n        asyncio.run(main())\n    except (KeyboardInterrupt, EOFError):\n        pass ",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 程序启动主函数：\nasync def main():\n    session_id = session.new_session_id()\n    store.ensure_memory_dir()\n    tasks_store = TasksStore(session_id=session_id)\n    state = SessionState(\n        model_name=MODEL_NAME,\n        session_id=session_id,\n        tasks_store=tasks_store,\n    )\n    print_welcome_banner(\"my-code-agent\")\n    repl = Repl(state)\n    async def on_submit(user_input):\n        action = await handle_command(user_input, state)\n        if action == \"break\":\n            repl.exit()\n            return\n        if action == \"continue\":\n            return\n        \n        inject_at_mentions(user_input, state)\n\n        repl.start_working()\n        \n        await recall.inject_memories(user_input, state)\n        \n        result = await run_agent_loop(user_input, state)\n\n        background.schedule(state, result.new_messages())\n    \n    await repl.run(on_submit)\n\n    await background.drain()\n\nif __name__ == \"__main__\":\n    try:\n        asyncio.run(main())\n    except (KeyboardInterrupt, EOFError):\n        pass ",
      "autoResize": true,
      "lineHeight": 1.25
    },
