      "link": null,
      "locked": false,
      "text": "def _written_memory_files(messages) -> list[str]:\n    written = []\n    for message in messages:\n        for part in message.parts:\n            if getattr(part, \"part_kind\", \"\") != \"tool-call\":\n                continue\n            if part.tool_name not in (\"write_file\", \"edit_file\"):\n                continue\n            path = str(part.args_as_dict().get(\"path\", \"\"))\n            if store.is_memory_path(path):\n                name = Path(path).name\n                if name != \"MEMORY.md\" and name not in written:\n                    written.append(name)\n    return written",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def _written_memory_files(messages) -> list[str]:\n    written = []\n    for message in messages:\n        for part in message.parts:\n            if getattr(part, \"part_kind\", \"\") != \"tool-call\":\n                continue\n            if part.tool_name not in (\"write_file\", \"edit_file\"):\n                continue\n            path = str(part.args_as_dict().get(\"path\", \"\"))\n            if store.is_memory_path(path):\n                name = Path(path).name\n                if name != \"MEMORY.md\" and name not in written:\n                    written.append(name)\n    return written",
      "autoResize": true,
      "lineHeight": 1.25
    },
