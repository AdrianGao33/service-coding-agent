      "isDeleted": false,
      "boundElements": [],
      "updated": 1793378880586,
      "link": null,
      "locked": false,
      "text": "MAX_RETRIES= 3                                           #1. 网络请求重试次数\nTASK_REMINDER_TURNS_SINCE_WRITE= 6                       #2. 模型连续几轮没用 task 工具考虑提醒\nTASK_REMINDER_TURNS_BETWEEN = 4                          #3. 两次 task 提醒之间至少间隔几轮，防止刷屏\n_TASK_MANAGEMENT_TOOLS = {\"task_create\", \"task_update\"}  #4. 哪些工具算\"task 管理动作\"——调过它们就重置 since_write 计数\n\nclass ApiCall:                                           #5. API调用元数据\n    model: str                                           # 模型名：deepseek\n    messages_count: int                                  # 发送给模型的历史消息数+当前消息，总条数\n    last_part: Any                                       # 发送消息中最后一条的最后一个 part\n    tools: list                                          # 本次允许调用的工具清单\n    finish_reason: str = \"\"                              # 结束原因\n    parts_kinds: list = field(default_factory=list)      # 消息类型\n    input_tokens: int = 0                                # 输入tokens数\n    output_tokens: int = 0                               # 输出tokens数\n\napi_call_log: list[ApiCall] = []                         #6. 大模型API调用记录状态保存",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "MAX_RETRIES= 3                                           #1. 网络请求重试次数\nTASK_REMINDER_TURNS_SINCE_WRITE= 6                       #2. 模型连续几轮没用 task 工具考虑提醒\nTASK_REMINDER_TURNS_BETWEEN = 4                          #3. 两次 task 提醒之间至少间隔几轮，防止刷屏\n_TASK_MANAGEMENT_TOOLS = {\"task_create\", \"task_update\"}  #4. 哪些工具算\"task 管理动作\"——调过它们就重置 since_write 计数\n\nclass ApiCall:                                           #5. API调用元数据\n    model: str                                           # 模型名：deepseek\n    messages_count: int                                  # 发送给模型的历史消息数+当前消息，总条数\n    last_part: Any                                       # 发送消息中最后一条的最后一个 part\n    tools: list                                          # 本次允许调用的工具清单\n    finish_reason: str = \"\"                              # 结束原因\n    parts_kinds: list = field(default_factory=list)      # 消息类型\n    input_tokens: int = 0                                # 输入tokens数\n    output_tokens: int = 0                               # 输出tokens数\n\napi_call_log: list[ApiCall] = []                         #6. 大模型API调用记录状态保存",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "ExlDweQBdkgEqDPA7u6yF",
      "type": "text",
