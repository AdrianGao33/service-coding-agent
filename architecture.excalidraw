      "link": null,
      "locked": false,
      "text": "def apply_result(state, result):\n    #1. 更新state上下文\n    state.history = result.all_messages()\n    usage = result.usage\n    state.input_tokens += usage.input_tokens\n    state.output_tokens += usage.output_tokens\n    state.last_api_calls = list(api_call_log)\n\n    #2. 更新这个session的jsonl\n    session.append_messages(state.session_id, result.new_messages())",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def apply_result(state, result):\n    #1. 更新state上下文\n    state.history = result.all_messages()\n    usage = result.usage\n    state.input_tokens += usage.input_tokens\n    state.output_tokens += usage.output_tokens\n    state.last_api_calls = list(api_call_log)\n\n    #2. 更新这个session的jsonl\n    session.append_messages(state.session_id, result.new_messages())",
      "autoResize": true,
      "lineHeight": 1.25
    },
