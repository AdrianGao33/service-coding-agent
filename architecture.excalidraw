      "locked": false,
      "text": "class ReadFileState:\n\n    def __init__(self):\n        # 字典映射：绝对路径 -> {1.\"content\": 文本, 2.\"timestamp\": 3.mtime时间戳, 4.\"offset\": 行偏移, 5.\"limit\": 读取行数}\n        self._state: dict = {}\n\n    def record(self, path: str, content: str, offset: int | None = None, limit: int | None = None) -> None:\n        self._state[os.path.abspath(path)] = {\n            \"content\": content,\n            \"timestamp\": os.path.getmtime(path), #系统捕获触发自动记录\n            \"offset\": offset,\n            \"limit\": limit,\n        }\n\n    def get(self, path: str):\n        return self._state.get(os.path.abspath(path))\n\n    def stale_paths(self) -> list[str]: #list[被动过的文件]\n        stale = []\n        for path, record in self._state.items():\n            try:\n                # 【磁盘文件上保存的最后修改时间】>【内存里记录的历史时间】做比对 (正常应该相等，但是大于说明改过)\n                if os.path.getmtime(path) > record[\"timestamp\"]:\n                    stale.append(path)\n            except OSError:\n                continue\n        return stale",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class ReadFileState:\n\n    def __init__(self):\n        # 字典映射：绝对路径 -> {1.\"content\": 文本, 2.\"timestamp\": 3.mtime时间戳, 4.\"offset\": 行偏移, 5.\"limit\": 读取行数}\n        self._state: dict = {}\n\n    def record(self, path: str, content: str, offset: int | None = None, limit: int | None = None) -> None:\n        self._state[os.path.abspath(path)] = {\n            \"content\": content,\n            \"timestamp\": os.path.getmtime(path), #系统捕获触发自动记录\n            \"offset\": offset,\n            \"limit\": limit,\n        }\n\n    def get(self, path: str):\n        return self._state.get(os.path.abspath(path))\n\n    def stale_paths(self) -> list[str]: #list[被动过的文件]\n        stale = []\n        for path, record in self._state.items():\n            try:\n                # 【磁盘文件上保存的最后修改时间】>【内存里记录的历史时间】做比对 (正常应该相等，但是大于说明改过)\n                if os.path.getmtime(path) > record[\"timestamp\"]:\n                    stale.append(path)\n            except OSError:\n                continue\n        return stale",
      "autoResize": true,
      "lineHeight": 1.25
    },
