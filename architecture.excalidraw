      "boundElements": [],
      "updated": 1793342962558,
      "link": null,
      "locked": false,
      "text": "def pop_unnotified(self) -> list[Job]:\n    done = [j for j in self._jobs.values() if j.background and j.status != \"running\" and not j.notified]\n    for job in done:\n        job.notified = True\n    return done",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def pop_unnotified(self) -> list[Job]:\n    done = [j for j in self._jobs.values() if j.background and j.status != \"running\" and not j.notified]\n    for job in done:\n        job.notified = True\n    return done",
      "autoResize": true,
      "lineHeight": 1.25
    },
