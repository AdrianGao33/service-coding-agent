      "index": "b2P",
      "roundness": null,
      "seed": 65034523,
      "version": 1416,
      "versionNonce": 1129689596,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "q5kuD--iX0IX8U_j35Ryv",
