      "updated": 1793194531980,
      "link": null,
      "locked": false,
      "text": "async def startup() -> str:\n    load_servers()\n    await asyncio.gather(*(_connect(record) for record in RECORDS))\n\n    connected = [r for r in RECORDS if r.status == \"connected\"]\n    failed = [r for r in RECORDS if r.status == \"failed\"]\n    parts = []\n    if connected:\n        parts.append(\n            \"已连接 MCP server：\" + \"、\".join(\n                f\"{r.toolset_id}（工具按需加载）\" if not r.tool_names else f\"{r.toolset_id}（{len(r.tool_names)} 个工具）\"\n                for r in connected\n            )\n        )\n    if failed:\n        parts.append(\"连接失败：\" + \"、\".join(r.toolset_id for r in failed) + \"（详情见 /mcp）\")\n    return \"；\".join(parts)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def startup() -> str:\n    load_servers()\n    await asyncio.gather(*(_connect(record) for record in RECORDS))\n\n    connected = [r for r in RECORDS if r.status == \"connected\"]\n    failed = [r for r in RECORDS if r.status == \"failed\"]\n    parts = []\n    if connected:\n        parts.append(\n            \"已连接 MCP server：\" + \"、\".join(\n                f\"{r.toolset_id}（工具按需加载）\" if not r.tool_names else f\"{r.toolset_id}（{len(r.tool_names)} 个工具）\"\n                for r in connected\n            )\n        )\n    if failed:\n        parts.append(\"连接失败：\" + \"、\".join(r.toolset_id for r in failed) + \"（详情见 /mcp）\")\n    return \"；\".join(parts)",
      "autoResize": true,
      "lineHeight": 1.25
    },
