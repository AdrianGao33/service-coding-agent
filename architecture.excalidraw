      "link": null,
      "locked": false,
      "text": "async def _extract(history: list) -> None:\n    result = await fork_agent.run(\n        _EXTRACT_PROMPT.format(manifest=_manifest_section()), \n        message_history=history,\n        deps=_fork_deps(),\n        usage_limits=UsageLimits(request_limit=MAX_FORK_REQUESTS),\n    )\n    written = _written_memory_files(result.new_messages())\n    if written:\n        print_step(\"[cyan]✦ memory[/]\", f\"[cyan dim]后台提炼保存了记忆：{'、'.join(written)}[/]\")",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def _extract(history: list) -> None:\n    result = await fork_agent.run(\n        _EXTRACT_PROMPT.format(manifest=_manifest_section()), \n        message_history=history,\n        deps=_fork_deps(),\n        usage_limits=UsageLimits(request_limit=MAX_FORK_REQUESTS),\n    )\n    written = _written_memory_files(result.new_messages())\n    if written:\n        print_step(\"[cyan]✦ memory[/]\", f\"[cyan dim]后台提炼保存了记忆：{'、'.join(written)}[/]\")",
      "autoResize": true,
      "lineHeight": 1.25
