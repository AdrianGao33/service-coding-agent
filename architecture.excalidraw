      "updated": 1793342724006,
      "link": null,
      "locked": false,
      "text": "def kill(self, job_id: str) -> bool:\n    job = self._jobs.get(job_id)\n    if job is None or job.status != \"running\":\n        return False\n   \n    job.status = \"killed\"\n    job.notified = True\n    if job.kill_func:\n        job.kill_func()\n    return True",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def kill(self, job_id: str) -> bool:\n    job = self._jobs.get(job_id)\n    if job is None or job.status != \"running\":\n        return False\n   \n    job.status = \"killed\"\n    job.notified = True\n    if job.kill_func:\n        job.kill_func()\n    return True",
      "autoResize": true,
      "lineHeight": 1.25
    },
