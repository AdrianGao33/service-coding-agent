      "link": null,
      "locked": false,
      "text": "def _backup(self, path: str, version: int):\n    if not os.path.exists(path):\n        return None\n    digest = hashlib.sha256(path.encode()).hexdigest()[:16]\n    name = f\"{digest}@v{version}\"\n    self.dir.mkdir(parents=True, exist_ok=True)\n    shutil.copy2(path, self.dir / name)\n    return name",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def _backup(self, path: str, version: int):\n    if not os.path.exists(path):\n        return None\n    digest = hashlib.sha256(path.encode()).hexdigest()[:16]\n    name = f\"{digest}@v{version}\"\n    self.dir.mkdir(parents=True, exist_ok=True)\n    shutil.copy2(path, self.dir / name)\n    return name",
      "autoResize": true,
      "lineHeight": 1.25
    },
