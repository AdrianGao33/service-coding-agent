      "text": "@hooks.on.model_request\nasync def _retry_on_error(ctx, *, request_context, handler):\n    for attempt in range(MAX_RETRIES + 1):\n        try:\n            return await handler(request_context)\n        except ModelHTTPError as e:\n            if e.status_code < 500: \n                raise\n            if attempt >= MAX_RETRIES:  \n                console.print(f\"[bold red]✗ HTTP {e.status_code}，重试 {MAX_RETRIES} 次后仍失败[/]\")\n                raise\n            wait = 2 ** attempt\n            console.print(\n                f\"[bold yellow]⟳ HTTP {e.status_code}，{wait}s 后重试 \"\n                f\"({attempt + 1}/{MAX_RETRIES})...[/]\"\n            )\n            await asyncio.sleep(wait)\n        except ModelAPIError as e:\n            if attempt >= MAX_RETRIES: \n                console.print(\n                    f\"[bold red]✗ 网络连接失败，重试 {MAX_RETRIES} 次后仍无法连接[/]\"\n                )\n                raise\n            wait = 2 ** attempt\n            console.print(\n                f\"[bold yellow]⟳ 网络连接失败，{wait}s 后重试 \"\n                f\"({attempt + 1}/{MAX_RETRIES})...[/]\"\n            )\n            await asyncio.sleep(wait)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@hooks.on.model_request\nasync def _retry_on_error(ctx, *, request_context, handler):\n    for attempt in range(MAX_RETRIES + 1):\n        try:\n            return await handler(request_context)\n        except ModelHTTPError as e:\n            if e.status_code < 500: \n                raise\n            if attempt >= MAX_RETRIES:  \n                console.print(f\"[bold red]✗ HTTP {e.status_code}，重试 {MAX_RETRIES} 次后仍失败[/]\")\n                raise\n            wait = 2 ** attempt\n            console.print(\n                f\"[bold yellow]⟳ HTTP {e.status_code}，{wait}s 后重试 \"\n                f\"({attempt + 1}/{MAX_RETRIES})...[/]\"\n            )\n            await asyncio.sleep(wait)\n        except ModelAPIError as e:\n            if attempt >= MAX_RETRIES: \n                console.print(\n                    f\"[bold red]✗ 网络连接失败，重试 {MAX_RETRIES} 次后仍无法连接[/]\"\n                )\n                raise\n            wait = 2 ** attempt\n            console.print(\n                f\"[bold yellow]⟳ 网络连接失败，{wait}s 后重试 \"\n                f\"({attempt + 1}/{MAX_RETRIES})...[/]\"\n            )\n            await asyncio.sleep(wait)",
      "autoResize": true,
      "lineHeight": 1.25
    },
