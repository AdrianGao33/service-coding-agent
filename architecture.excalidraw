      "link": null,
      "locked": false,
      "text": "4. 工具执行hook：\n@hooks.on.tool_execute\nasync def _check_permission(ctx, *, call, tool_def, args, handler):\n    decision = permissions.compute_decision(call.tool_name, args)\n    if decision == \"allow\":\n        return await handler(args)\n \n# 当规则要求询问 (\"ask\") 且处于 AUTO 模式：交由 classifier 智能审查\n    if permissions.state.mode == permissions.AUTO:\n        print_step(\"[blue]◆ auto_check[/]\", f\"[blue dim]正在请 LLM 审查 {call.tool_name}...[/]\")\n        verdict = await classifier.classify(ctx.messages, call.tool_name, args)\n        if verdict.get(\"error\"):\n            print_step(\"[yellow]⚠ auto_check[/]\", f\"[yellow]{verdict['reason']}[/]\")\n        elif not verdict[\"should_block\"]:\n            print_step(\"[blue]✔ auto_check[/]\", f\"[blue dim]放行：{verdict['reason']}[/]\")\n            return await handler(args)\n        else:\n            print_step(\"[red]✘ auto_check[/]\", f\"[red]拦截：{verdict['reason']}[/]\")\n            return (\n                f\"安全检查拦截了这次 {call.tool_name} 调用，没有执行。拦截理由：{verdict['reason']}。\"\n                \"不要尝试绕过拦截，请停下来向用户说明情况，由用户决定接下来怎么做。\"\n            )\n\n    choice = await permissions.prompt_approval(call.tool_name, args)\n    if choice == \"once\":\n        return await handler(args)\n    if choice == \"always\":\n        permissions.state.session_allowed.add(call.tool_name)\n        return await handler(args)\n    return f\"用户拒绝了对 {call.tool_name} 的调用，这次调用没有执行。请停下手上的事，等用户告诉你接下来该怎么做。\"\n\n5. 工具执行报错hook：\n@hooks.on.tool_execute_error\nasync def _handle_tool_error(ctx, *, call, tool_def, args, error):\n    console.print(f\"[bold red]✗ 工具 {call.tool_name} 出错：{error}[/]\")   \n    return f\"工具执行出错：{type(error).__name__}: {error}\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. 工具执行hook：\n@hooks.on.tool_execute\nasync def _check_permission(ctx, *, call, tool_def, args, handler):\n    decision = permissions.compute_decision(call.tool_name, args)\n    if decision == \"allow\":\n        return await handler(args)\n \n# 当规则要求询问 (\"ask\") 且处于 AUTO 模式：交由 classifier 智能审查\n    if permissions.state.mode == permissions.AUTO:\n        print_step(\"[blue]◆ auto_check[/]\", f\"[blue dim]正在请 LLM 审查 {call.tool_name}...[/]\")\n        verdict = await classifier.classify(ctx.messages, call.tool_name, args)\n        if verdict.get(\"error\"):\n            print_step(\"[yellow]⚠ auto_check[/]\", f\"[yellow]{verdict['reason']}[/]\")\n        elif not verdict[\"should_block\"]:\n            print_step(\"[blue]✔ auto_check[/]\", f\"[blue dim]放行：{verdict['reason']}[/]\")\n            return await handler(args)\n        else:\n            print_step(\"[red]✘ auto_check[/]\", f\"[red]拦截：{verdict['reason']}[/]\")\n            return (\n                f\"安全检查拦截了这次 {call.tool_name} 调用，没有执行。拦截理由：{verdict['reason']}。\"\n                \"不要尝试绕过拦截，请停下来向用户说明情况，由用户决定接下来怎么做。\"\n            )\n\n    choice = await permissions.prompt_approval(call.tool_name, args)\n    if choice == \"once\":\n        return await handler(args)\n    if choice == \"always\":\n        permissions.state.session_allowed.add(call.tool_name)\n        return await handler(args)\n    return f\"用户拒绝了对 {call.tool_name} 的调用，这次调用没有执行。请停下手上的事，等用户告诉你接下来该怎么做。\"\n\n5. 工具执行报错hook：\n@hooks.on.tool_execute_error\nasync def _handle_tool_error(ctx, *, call, tool_def, args, error):\n    console.print(f\"[bold red]✗ 工具 {call.tool_name} 出错：{error}[/]\")   \n    return f\"工具执行出错：{type(error).__name__}: {error}\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "GKii8Dm4QrymVWNfBZiKX",
      "type": "text",
      "x": -2789.2222222222217,
      "y": -1561.777777777782,
      "width": 525,
      "height": 125,
      "angle": 0,
      "strokeColor": "#0c8599",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 464089211,
      "version": 881,
      "versionNonce": 965504059,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791623816599,
      "link": null,
      "locked": false,
      "text": "1. 请求前hook：@hooks.on.before_model_request\n2. 请求后hook：@hooks.on.after_model_request\n3. 请求报错hook：@hooks.on.model_request\n4. 工具执行hook：@hooks.on.tool_execute\n5. 工具执行报错hook：@hooks.on.tool_execute_error",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1. 请求前hook：@hooks.on.before_model_request\n2. 请求后hook：@hooks.on.after_model_request\n3. 请求报错hook：@hooks.on.model_request\n4. 工具执行hook：@hooks.on.tool_execute\n5. 工具执行报错hook：@hooks.on.tool_execute_error",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Kmz8Rf_PXz9WiTteeb9UD",
      "type": "text",
      "x": -3219.8888888888896,
      "y": -42.61111111111518,
      "width": 853.5988159179688,
      "height": 580,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1J",
      "roundness": null,
      "seed": 2136000059,
      "version": 711,
      "versionNonce": 743545403,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791719484196,
      "link": null,
      "locked": false,
      "text": "\n# 1. 请求前hook： request_context：准备塞给大模型的数据（包含 Prompt、历史消息、工具列表等）\n@hooks.on.before_model_request\nasync def _record_request(ctx, request_context):\n    msgs = list(request_context.messages)\n    last_part = msgs[-1].parts[-1] if msgs and msgs[-1].parts else None\n    try:\n        tool_names = [t.name for t in request_context.model_request_parameters.function_tools]\n    except AttributeError:\n        tool_names = []\n\n    api_call_log.append(ApiCall(\n        model=request_context.model.model_name,\n        messages_count=len(msgs),\n        last_part=last_part,\n        tools=tool_names,\n    ))\n    return request_context\n\n# 2. 请求后hook：response：大模型 API 刚返回的原始结果（包含生成文本、Token 消耗、finish_reason）。\n@hooks.on.after_model_request\nasync def _record_response(ctx, request_context, response):\n    if api_call_log:\n        call = api_call_log[-1]\n        call.finish_reason = str(response.finish_reason) if response.finish_reason else \"unknown\"\n        call.parts_kinds = [p.part_kind for p in response.parts]\n        call.input_tokens = response.usage.input_tokens\n        call.output_tokens = response.usage.output_tokens\n    return response",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n# 1. 请求前hook： request_context：准备塞给大模型的数据（包含 Prompt、历史消息、工具列表等）\n@hooks.on.before_model_request\nasync def _record_request(ctx, request_context):\n    msgs = list(request_context.messages)\n    last_part = msgs[-1].parts[-1] if msgs and msgs[-1].parts else None\n    try:\n        tool_names = [t.name for t in request_context.model_request_parameters.function_tools]\n    except AttributeError:\n        tool_names = []\n\n    api_call_log.append(ApiCall(\n        model=request_context.model.model_name,\n        messages_count=len(msgs),\n        last_part=last_part,\n        tools=tool_names,\n    ))\n    return request_context\n\n# 2. 请求后hook：response：大模型 API 刚返回的原始结果（包含生成文本、Token 消耗、finish_reason）。\n@hooks.on.after_model_request\nasync def _record_response(ctx, request_context, response):\n    if api_call_log:\n        call = api_call_log[-1]\n        call.finish_reason = str(response.finish_reason) if response.finish_reason else \"unknown\"\n        call.parts_kinds = [p.part_kind for p in response.parts]\n        call.input_tokens = response.usage.input_tokens\n        call.output_tokens = response.usage.output_tokens\n    return response",
      "autoResize": true,
      "lineHeight": 1.25
    },
