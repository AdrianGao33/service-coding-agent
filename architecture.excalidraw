      "link": null,
      "locked": false,
      "text": "def has_memory_writes(messages) -> bool:\n    for message in messages:\n        for part in message.parts:\n            if getattr(part, \"part_kind\", \"\") != \"tool-call\":\n                continue\n            if part.tool_name not in (\"write_file\", \"edit_file\"):\n                continue\n            if is_memory_path(str(part.args_as_dict().get(\"path\", \"\"))):\n                return True\n    return False",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def has_memory_writes(messages) -> bool:\n    for message in messages:\n        for part in message.parts:\n            if getattr(part, \"part_kind\", \"\") != \"tool-call\":\n                continue\n            if part.tool_name not in (\"write_file\", \"edit_file\"):\n                continue\n            if is_memory_path(str(part.args_as_dict().get(\"path\", \"\"))):\n                return True\n    return False",
      "autoResize": true,
      "lineHeight": 1.25
    },
