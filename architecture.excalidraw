      "updated": 1791623816599,
      "link": null,
      "locked": false,
      "text": "# 导出工具列表给agent实例初始化\nTOOLS = [read_file, write_file, run_command]\n\n# 工具1：读文件\ndef read_file(path: str) -> str:\n    try:\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            return f.read()\n    ... 放错excepts\\returns...\n\n# 工具2：写文件\ndef write_file(path: str, content: str) -> str:\n    try:\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            f.write(content)\n        return f\"已写入 {path}\"\n    ... 放错excepts\\returns...\n\n# 工具3：运行shell命令\ndef run_command(command: str) -> str:\n    try:\n        result = subprocess.run(\n            command\n        ....配置参数....\n        )\n        output = result.stdout\n        if result.returncode != 0:\n            output += f\"\\n[错误] {result.stderr}\"\n        return output or \"(无输出)\"\n    ... 放错excepts\\returns...\n\n\n# 工具3的安全拦截函数，前置检查\ndef run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    return None\n\n# 注册到permission的run_command处理\npermissions.register_self_check(\"run_command\", run_command_self_check)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 导出工具列表给agent实例初始化\nTOOLS = [read_file, write_file, run_command]\n\n# 工具1：读文件\ndef read_file(path: str) -> str:\n    try:\n        with open(path, \"r\", encoding=\"utf-8\") as f:\n            return f.read()\n    ... 放错excepts\\returns...\n\n# 工具2：写文件\ndef write_file(path: str, content: str) -> str:\n    try:\n        with open(path, \"w\", encoding=\"utf-8\") as f:\n            f.write(content)\n        return f\"已写入 {path}\"\n    ... 放错excepts\\returns...\n\n# 工具3：运行shell命令\ndef run_command(command: str) -> str:\n    try:\n        result = subprocess.run(\n            command\n        ....配置参数....\n        )\n        output = result.stdout\n        if result.returncode != 0:\n            output += f\"\\n[错误] {result.stderr}\"\n        return output or \"(无输出)\"\n    ... 放错excepts\\returns...\n\n\n# 工具3的安全拦截函数，前置检查\ndef run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    return None\n\n# 注册到permission的run_command处理\npermissions.register_self_check(\"run_command\", run_command_self_check)",
      "autoResize": true,
      "lineHeight": 1.25
    },
