      "updated": 1793425424839,
      "link": null,
      "locked": false,
      "text": "def build_file_reminder_text(state: ReadFileState) -> str | None:\n    stale = state.stale_paths()\n    if not stale:\n        return None\n\n    lines = [\n        \"以下文件在你读取之后被外部修改过，你 context 里的内容可能已过时，编辑前请重新用 read_file 读取：\",\n    ]\n    lines += [f\"- {path}\" for path in stale]\n    body = \"\\n\".join(lines)\n\n    return _wrap(lines)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def build_file_reminder_text(state: ReadFileState) -> str | None:\n    stale = state.stale_paths()\n    if not stale:\n        return None\n\n    lines = [\n        \"以下文件在你读取之后被外部修改过，你 context 里的内容可能已过时，编辑前请重新用 read_file 读取：\",\n    ]\n    lines += [f\"- {path}\" for path in stale]\n    body = \"\\n\".join(lines)\n\n    return _wrap(lines)",
      "autoResize": true,
      "lineHeight": 1.25
    },
