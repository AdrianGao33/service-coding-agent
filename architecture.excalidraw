      "text": "    初始化：api_call_log: list[ApiCall] = []\n当前这轮对话产生的 API 调用记录：\n请求侧元数据：model, message_count, last_part, tools, \n响应侧元数据：finish_reason, parts_kinds, input_tokens, output_tokens",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "    初始化：api_call_log: list[ApiCall] = []\n当前这轮对话产生的 API 调用记录：\n请求侧元数据：model, message_count, last_part, tools, \n响应侧元数据：finish_reason, parts_kinds, input_tokens, output_tokens",
      "autoResize": true,
      "lineHeight": 1.25
    },
