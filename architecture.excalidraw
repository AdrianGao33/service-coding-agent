      "updated": 1793346232831,
      "link": null,
      "locked": false,
      "text": "async def dream(history: list, *, force: bool = False, session_id: str = \"\") -> None:\n    if not force and not _dream_due(session_id):\n        return\n    headers = store.scan_memory_files()\n    if not headers:\n        if force:\n            print_step(\"[cyan]✦ memory[/]\", \"[cyan dim]还没有任何记忆，无需整理[/]\")\n        return\n    \n    result = await fork_agent.run(\n        _DREAM_PROMPT.format(memory_dir=store.memory_dir(), manifest=store.format_manifest(headers)),\n        message_history=history,\n        deps=_fork_deps(),\n        usage_limits=UsageLimits(request_limit=MAX_FORK_REQUESTS),\n    )\n\n    _lock_path().touch()           \n    print_step(\"[cyan]✦ memory[/]\", f\"[cyan dim]{result.output}[/]\")",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def dream(history: list, *, force: bool = False, session_id: str = \"\") -> None:\n    if not force and not _dream_due(session_id):\n        return\n    headers = store.scan_memory_files()\n    if not headers:\n        if force:\n            print_step(\"[cyan]✦ memory[/]\", \"[cyan dim]还没有任何记忆，无需整理[/]\")\n        return\n    \n    result = await fork_agent.run(\n        _DREAM_PROMPT.format(memory_dir=store.memory_dir(), manifest=store.format_manifest(headers)),\n        message_history=history,\n        deps=_fork_deps(),\n        usage_limits=UsageLimits(request_limit=MAX_FORK_REQUESTS),\n    )\n\n    _lock_path().touch()           \n    print_step(\"[cyan]✦ memory[/]\", f\"[cyan dim]{result.output}[/]\")",
      "autoResize": true,
      "lineHeight": 1.25
    },
