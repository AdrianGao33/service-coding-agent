      "updated": 1793425805865,
      "link": null,
      "locked": false,
      "text": "def task_create(ctx: RunContext[AgentDeps], subject: str, description: str, active_form: str | None = None) -> dict:\n    store = ctx.deps.tasks_store\n    task_id = store.create(subject=subject, description=description, active_form=active_form)\n    return {\"id\": task_id, \"subject\": subject}",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def task_create(ctx: RunContext[AgentDeps], subject: str, description: str, active_form: str | None = None) -> dict:\n    store = ctx.deps.tasks_store\n    task_id = store.create(subject=subject, description=description, active_form=active_form)\n    return {\"id\": task_id, \"subject\": subject}",
      "autoResize": true,
      "lineHeight": 1.25
    },
