      "text": "def context_tokens(history) -> int:\n    for msg in reversed(history):\n        if msg.kind == \"response\" and msg.usage.input_tokens:\n            return msg.usage.input_tokens + msg.usage.output_tokens\n    return 0",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def context_tokens(history) -> int:\n    for msg in reversed(history):\n        if msg.kind == \"response\" and msg.usage.input_tokens:\n            return msg.usage.input_tokens + msg.usage.output_tokens\n    return 0",
      "autoResize": true,
      "lineHeight": 1.25
    },
