      "updated": 1792610798998,
      "link": null,
      "locked": false,
      "text": "# 根据当前模式、是否“不再询问”、白名单、危险操作、按优先级判断\ndef compute_decision(tool_name: str, args: dict) -> str:\n    if state.mode == BYPASS:\n        return \"allow\"\n    check = TOOL_SELF_CHECKS.get(tool_name)\n    if check and check(args) == \"ask\":\n        return \"ask\"\n    if tool_name in state.session_allowed:\n        return \"allow\"\n    if tool_name in READONLY_TOOLS:\n        return \"allow\"\n    if tool_name in EDIT_TOOLS and store.is_memory_path(str(args.get(\"path\", \"\"))):\n        return \"allow\"\n    if state.mode in (ACCEPT_EDITS, AUTO) and tool_name in EDIT_TOOLS:\n        return \"allow\"\n    return \"ask\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# 根据当前模式、是否“不再询问”、白名单、危险操作、按优先级判断\ndef compute_decision(tool_name: str, args: dict) -> str:\n    if state.mode == BYPASS:\n        return \"allow\"\n    check = TOOL_SELF_CHECKS.get(tool_name)\n    if check and check(args) == \"ask\":\n        return \"ask\"\n    if tool_name in state.session_allowed:\n        return \"allow\"\n    if tool_name in READONLY_TOOLS:\n        return \"allow\"\n    if tool_name in EDIT_TOOLS and store.is_memory_path(str(args.get(\"path\", \"\"))):\n        return \"allow\"\n    if state.mode in (ACCEPT_EDITS, AUTO) and tool_name in EDIT_TOOLS:\n        return \"allow\"\n    return \"ask\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
