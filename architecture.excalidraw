      "text": "def _scan_task_turn_counters(messages) -> tuple[int, int]:\n    since_mgmt = 0\n    since_reminder = 0\n    found_mgmt = False\n    found_reminder = False\n    for msg in reversed(messages):\n        if isinstance(msg, ModelResponse):  \n            if not found_mgmt:\n                for part in msg.parts:\n                    if (\n                        isinstance(part, ToolCallPart) \n                        and part.tool_name in _TASK_MANAGEMENT_TOOLS\n                    ):                      #{\"task_create\", \"task_update\"}\n                        found_mgmt = True\n                        break\n\n                if not found_mgmt:\n                    since_mgmt += 1\n            if not found_reminder:\n                since_reminder += 1\n      \n        elif isinstance(msg, ModelRequest) and not found_reminder:\n            for part in msg.parts:\n                if (\n                    isinstance(part, UserPromptPart) \n                    and isinstance(part.content, str) \n                    and _REMINDER_SENTINELS[\"task\"] in part.content\n                ):\n                    found_reminder = True\n                    break\n\n        if found_mgmt and found_reminder:\n            break\n    return since_mgmt, since_reminder\n\ndef _build_file_reminder(ctx, messages) -> str | None:\n    \"\"\"过期文件提醒构建器：检测 ReadFileState 账本是否有文件被外部改过\"\"\"\n    return build_reminder_text(ctx.deps.read_file_state)\n\ndef _build_task_reminder(ctx, messages) -> str | None:\n\n    if since_mgmt < TASK_REMINDER_TURNS_SINCE_WRITE:\n        return None\n    if since_reminder < TASK_REMINDER_TURNS_BETWEEN:\n        return None\n    return build_task_reminder_text(ctx.deps.tasks_store)\n\ndef _build_job_reminder(ctx, messages) -> str | None:\n    return build_job_reminder_text(ctx.deps.job_registry)\n\n\n\n\n@hooks.on.before_model_request\nasync def _inject_reminders(ctx, request_context):\n    messages = list(request_context.messages)\n    appended = []\n    for builder in _REMINDER_BUILDERS:\n        text = builder(ctx, messages + appended)\n        if text is None:\n            continue\n        appended.append(ModelRequest(parts=[UserPromptPart(content=text)]))\n        print_step(\"[dim]◇ system[/]\", f\"[dim]{text[:200]}[/]\")\n    if not appended:\n        return request_context\n    return dataclasses.replace(request_context, messages=messages + appended)\n",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def _scan_task_turn_counters(messages) -> tuple[int, int]:\n    since_mgmt = 0\n    since_reminder = 0\n    found_mgmt = False\n    found_reminder = False\n    for msg in reversed(messages):\n        if isinstance(msg, ModelResponse):  \n            if not found_mgmt:\n                for part in msg.parts:\n                    if (\n                        isinstance(part, ToolCallPart) \n                        and part.tool_name in _TASK_MANAGEMENT_TOOLS\n                    ):                      #{\"task_create\", \"task_update\"}\n                        found_mgmt = True\n                        break\n\n                if not found_mgmt:\n                    since_mgmt += 1\n            if not found_reminder:\n                since_reminder += 1\n      \n        elif isinstance(msg, ModelRequest) and not found_reminder:\n            for part in msg.parts:\n                if (\n                    isinstance(part, UserPromptPart) \n                    and isinstance(part.content, str) \n                    and _REMINDER_SENTINELS[\"task\"] in part.content\n                ):\n                    found_reminder = True\n                    break\n\n        if found_mgmt and found_reminder:\n            break\n    return since_mgmt, since_reminder\n\ndef _build_file_reminder(ctx, messages) -> str | None:\n    \"\"\"过期文件提醒构建器：检测 ReadFileState 账本是否有文件被外部改过\"\"\"\n    return build_reminder_text(ctx.deps.read_file_state)\n\ndef _build_task_reminder(ctx, messages) -> str | None:\n\n    if since_mgmt < TASK_REMINDER_TURNS_SINCE_WRITE:\n        return None\n    if since_reminder < TASK_REMINDER_TURNS_BETWEEN:\n        return None\n    return build_task_reminder_text(ctx.deps.tasks_store)\n\ndef _build_job_reminder(ctx, messages) -> str | None:\n    return build_job_reminder_text(ctx.deps.job_registry)\n\n\n\n\n@hooks.on.before_model_request\nasync def _inject_reminders(ctx, request_context):\n    messages = list(request_context.messages)\n    appended = []\n    for builder in _REMINDER_BUILDERS:\n        text = builder(ctx, messages + appended)\n        if text is None:\n            continue\n        appended.append(ModelRequest(parts=[UserPromptPart(content=text)]))\n        print_step(\"[dim]◇ system[/]\", f\"[dim]{text[:200]}[/]\")\n    if not appended:\n        return request_context\n    return dataclasses.replace(request_context, messages=messages + appended)\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
