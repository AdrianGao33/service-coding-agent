      "updated": 1792292556848,
      "link": null,
      "locked": false,
      "text": "DANGEROUS_PATTERNS = [...黑名单：高危命令...]\nSHELL_META = re.compile(r\"[;&|<>`$\\n]\") #黑名单：操作符（重定向）\n\n# 黑白名单检查\ndef run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    if is_readonly_command(command):\n        return \"allow\"\n    return None",
      "fontSize": 16.161159640307808,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "DANGEROUS_PATTERNS = [...黑名单：高危命令...]\nSHELL_META = re.compile(r\"[;&|<>`$\\n]\") #黑名单：操作符（重定向）\n\n# 黑白名单检查\ndef run_command_self_check(args: dict):\n    command = args.get(\"command\", \"\")\n    if any(re.search(pattern, command) for pattern in DANGEROUS_PATTERNS):\n        return \"ask\"\n    if is_readonly_command(command):\n        return \"allow\"\n    return None",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "fllC9x4imZbhmMV5d8R5U",
      "type": "text",
      "x": -2445.2986198645563,
      "y": -70.28194780308274,
      "width": 510.3992919921875,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "cZuHN9jyxqEqe4PXqJwFj"
      ],
      "frameId": null,
      "index": "b3as",
      "roundness": null,
      "seed": 1886239812,
      "version": 999,
      "versionNonce": 1159468531,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "3qilwvU3JnsIcvNK2mjCz",
          "type": "arrow"
        }
      ],
      "updated": 1792292556848,
      "link": null,
      "locked": false,
      "text": "READONLY_COMMANDS = {...白名单：命令...}\n\ndef is_readonly_command(command: str) -> bool:\n    if SHELL_META.search(command): \n        return False\n    try: \n        tokens = shlex.split(command)\n    except ValueError:\n        return False\n    return bool(tokens) and tokens[0] in READONLY_COMMANDS",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "READONLY_COMMANDS = {...白名单：命令...}\n\ndef is_readonly_command(command: str) -> bool:\n    if SHELL_META.search(command): \n        return False\n    try: \n        tokens = shlex.split(command)\n    except ValueError:\n        return False\n    return bool(tokens) and tokens[0] in READONLY_COMMANDS",
      "autoResize": true,
      "lineHeight": 1.25
    },
