      "link": null,
      "locked": false,
      "text": "def rewind_files(self, cp: Checkpoint) -> list:\n    plan = self.diff_stats(cp)\n    for change in plan:\n        if change.action == \"delete\":\n           os.remove(change.path)                       \n        else:\n            version = self._target_version(cp, change.path)\n            name = self.versions[change.path][version - 1]\n            shutil.copy2(self.dir / name, change.path)\n    return plan",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def rewind_files(self, cp: Checkpoint) -> list:\n    plan = self.diff_stats(cp)\n    for change in plan:\n        if change.action == \"delete\":\n           os.remove(change.path)                       \n        else:\n            version = self._target_version(cp, change.path)\n            name = self.versions[change.path][version - 1]\n            shutil.copy2(self.dir / name, change.path)\n    return plan",
      "autoResize": true,
      "lineHeight": 1.25
    },
