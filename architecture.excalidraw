      "seed": 866304161,
      "version": 3017,
      "versionNonce": 37224210,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793379052449,
      "link": null,
      "locked": false,
      "text": "USER_CONFIG= Path.home() / \".my-code-agent\" / \"mcp.json\"  #1. 全局的MCP服务存放地址\nPROJECT_CONFIG = Path(\".mcp.json\")                        #2. 本项目的MCP服务存放地址\nclass ServerRecord:                                     \n    toolset: Any                                        # 实际的工具集对象\n    transport: str = \"\"                                 # 传输通道描述（如本地命令行进程或远程 HTTP 地址）\n    status: str = \"pending\"                             # 状态：pending（未连接）、connected（已连接）、failed（连接失败）\n    error: str = \"\"                                     # 记录连接失败时的错误原因\n    tool_names: list[str] = field(default_factory=list) # 该服务包含的工具名称清单\n    toolset_id: str = \"\"                                # 服务的唯一标识名\nRECORDS: list[ServerRecord] = []          #3. 全局状态：所有 MCP 服务的记录表，以及用来统一管理异步上下文退出的堆栈\n_stack = AsyncExitStack()                 #4. 全局异步退出堆栈，用于动态托管并统一销毁所有 MCP 服务的异步连接资源",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "USER_CONFIG= Path.home() / \".my-code-agent\" / \"mcp.json\"  #1. 全局的MCP服务存放地址\nPROJECT_CONFIG = Path(\".mcp.json\")                        #2. 本项目的MCP服务存放地址\nclass ServerRecord:                                     \n    toolset: Any                                        # 实际的工具集对象\n    transport: str = \"\"                                 # 传输通道描述（如本地命令行进程或远程 HTTP 地址）\n    status: str = \"pending\"                             # 状态：pending（未连接）、connected（已连接）、failed（连接失败）\n    error: str = \"\"                                     # 记录连接失败时的错误原因\n    tool_names: list[str] = field(default_factory=list) # 该服务包含的工具名称清单\n    toolset_id: str = \"\"                                # 服务的唯一标识名\nRECORDS: list[ServerRecord] = []          #3. 全局状态：所有 MCP 服务的记录表，以及用来统一管理异步上下文退出的堆栈\n_stack = AsyncExitStack()                 #4. 全局异步退出堆栈，用于动态托管并统一销毁所有 MCP 服务的异步连接资源",
      "autoResize": true,
      "lineHeight": 1.25
    },
