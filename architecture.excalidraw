      "text": "def cycle_mode() -> str:\n    index = MODES.index(state.mode)\n    state.mode = MODES[(index + 1) % len(MODES)]\n    return state.mode",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def cycle_mode() -> str:\n    index = MODES.index(state.mode)\n    state.mode = MODES[(index + 1) % len(MODES)]\n    return state.mode",
      "autoResize": true,
