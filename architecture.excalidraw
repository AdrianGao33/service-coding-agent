      "updated": 1792320746014,
      "link": null,
      "locked": false,
      "text": "按照session_id/tid（一个自增数字）：Task的json文件，存任务状态\n            TasksStore._tasks[Task.id] = Task",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "按照session_id/tid（一个自增数字）：Task的json文件，存任务状态\n            TasksStore._tasks[Task.id] = Task",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WUsUEcUqtQjoeRoahtH30",
      "type": "text",
      "x": -366.36929909306184,
      "y": -2190.2700965931076,
      "width": 1237.5982666015625,
      "height": 860,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "giHBDwivmn-X7eu11QiJ6"
      ],
      "frameId": null,
      "index": "b4t",
      "roundness": null,
      "seed": 687073181,
      "version": 1061,
      "versionNonce": 362440787,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792320597366,
      "link": null,
      "locked": false,
      "text": "def create(self, subject: str, description: str, active_form: str | None = None) -> str:\n    current_max = max((int(tid) for tid in self._tasks), default=0)\n    next_id = max(current_max, self._highwatermark) + 1 #水位文件+1隔离\n    task = Task(\n        id=str(next_id),\n        subject=subject,\n        description=description,\n        active_form=active_form,\n    )\n    self._tasks[task.id] = task\n    self._write(task)\n    return task.id\n\ndef list(self) -> list[Task]:\n    return sorted(self._tasks.values(), key=lambda t: int(t.id))\n\ndef get(self, task_id: str) -> Task | None:\n    return self._tasks.get(task_id)\n\ndef update(self, task_id: str, **fields) -> Task:   #**argus\n    task = self._tasks.get(task_id)\n    if task is None:\n        raise KeyError(f\"task #{task_id} not found\")\n    add_blocks = fields.pop(\"add_blocks\", None)\n    add_blocked_by = fields.pop(\"add_blocked_by\", None)\n    new_blocks = list(dict.fromkeys(task.blocks + list(add_blocks))) if add_blocks else task.blocks     #append新的blocks\n    new_blocked_by = list(dict.fromkeys(task.blocked_by + list(add_blocked_by))) if add_blocked_by else task.blocked_by #append新的blocked_by\n    updated = replace(task, **fields, blocks=new_blocks, blocked_by=new_blocked_by)     #更新替换\n    self._tasks[task_id] = updated\n    self._write(updated)\n    return updated\n\ndef delete(self, task_id: str) -> None:\n    if task_id not in self._tasks:\n        raise KeyError(f\"task #{task_id} not found\")\n    \n    current_max = max((int(tid) for tid in self._tasks), default=0)\n    if current_max > self._highwatermark:\n        self._highwatermark = current_max\n        self._write_highwatermark(self._highwatermark)\n\n    del self._tasks[task_id]\n    self._task_path(task_id).unlink()",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def create(self, subject: str, description: str, active_form: str | None = None) -> str:\n    current_max = max((int(tid) for tid in self._tasks), default=0)\n    next_id = max(current_max, self._highwatermark) + 1 #水位文件+1隔离\n    task = Task(\n        id=str(next_id),\n        subject=subject,\n        description=description,\n        active_form=active_form,\n    )\n    self._tasks[task.id] = task\n    self._write(task)\n    return task.id\n\ndef list(self) -> list[Task]:\n    return sorted(self._tasks.values(), key=lambda t: int(t.id))\n\ndef get(self, task_id: str) -> Task | None:\n    return self._tasks.get(task_id)\n\ndef update(self, task_id: str, **fields) -> Task:   #**argus\n    task = self._tasks.get(task_id)\n    if task is None:\n        raise KeyError(f\"task #{task_id} not found\")\n    add_blocks = fields.pop(\"add_blocks\", None)\n    add_blocked_by = fields.pop(\"add_blocked_by\", None)\n    new_blocks = list(dict.fromkeys(task.blocks + list(add_blocks))) if add_blocks else task.blocks     #append新的blocks\n    new_blocked_by = list(dict.fromkeys(task.blocked_by + list(add_blocked_by))) if add_blocked_by else task.blocked_by #append新的blocked_by\n    updated = replace(task, **fields, blocks=new_blocks, blocked_by=new_blocked_by)     #更新替换\n    self._tasks[task_id] = updated\n    self._write(updated)\n    return updated\n\ndef delete(self, task_id: str) -> None:\n    if task_id not in self._tasks:\n        raise KeyError(f\"task #{task_id} not found\")\n    \n    current_max = max((int(tid) for tid in self._tasks), default=0)\n    if current_max > self._highwatermark:\n        self._highwatermark = current_max\n        self._write_highwatermark(self._highwatermark)\n\n    del self._tasks[task_id]\n    self._task_path(task_id).unlink()",
      "autoResize": true,
      "lineHeight": 1.25
    },
