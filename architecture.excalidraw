      "versionNonce": 2031336334,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793346179171,
      "link": null,
      "locked": false,
      "text": "def age_days(mtime: float) -> int:\n    return max(0, int((time.time() - mtime) // 86400))\n\ndef age_text(days: int) -> str:\n    if days == 0:\n        return \"今天\"\n    if days == 1:\n        return \"昨天\"\n    return f\"{days} 天前\"\n\ndef staleness_text(days: int) -> str:\n    return (\n        f\"这条记忆已保存 {days} 天。记忆是写入当时的快照，不是实时状态——\"\n        \"其中关于代码行为、文件位置的描述可能已经过期，先核对当前代码再当作事实使用。\"\n    )",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def age_days(mtime: float) -> int:\n    return max(0, int((time.time() - mtime) // 86400))\n\ndef age_text(days: int) -> str:\n    if days == 0:\n        return \"今天\"\n    if days == 1:\n        return \"昨天\"\n    return f\"{days} 天前\"\n\ndef staleness_text(days: int) -> str:\n    return (\n        f\"这条记忆已保存 {days} 天。记忆是写入当时的快照，不是实时状态——\"\n        \"其中关于代码行为、文件位置的描述可能已经过期，先核对当前代码再当作事实使用。\"\n    )",
      "autoResize": true,
      "lineHeight": 1.25
    },
