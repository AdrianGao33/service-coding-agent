      "link": null,
      "locked": false,
      "text": "def memory_dir() -> Path:\n    return session.project_dir() / \"memory\"\n\ndef index_path() -> Path:\n    return memory_dir() / \"MEMORY.md\"\n\ndef ensure_memory_dir() -> None:\n    memory_dir().mkdir(parents=True, exist_ok=True)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def memory_dir() -> Path:\n    return session.project_dir() / \"memory\"\n\ndef index_path() -> Path:\n    return memory_dir() / \"MEMORY.md\"\n\ndef ensure_memory_dir() -> None:\n    memory_dir().mkdir(parents=True, exist_ok=True)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "DdUYQ6TyEJWl_GuqaX95H",
