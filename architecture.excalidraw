      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "VMtGU08fn6eLLwyEtiMiK"
      ],
      "frameId": null,
      "index": "b0G",
      "roundness": null,
      "seed": 62544053,
      "version": 2176,
