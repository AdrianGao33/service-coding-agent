      "link": null,
      "locked": false,
      "text": "async def handle_command(user_input, state) -> str:\n\n    if not user_input.startswith(\"/\"):\n        return \"pass\"\n    cmd_name = user_input[1:].split()[0]\n    command = COMMANDS.get(cmd_name)\n    if command is None:\n        console.print(f\"未知命令：/{cmd_name}，输入 /help 查看可用命令\\n\")\n        return \"continue\"\n    \n    result = command.handler(state)\n    if asyncio.iscoroutine(result):\n        result = await result\n    return \"continue\" if result else \"break\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "async def handle_command(user_input, state) -> str:\n\n    if not user_input.startswith(\"/\"):\n        return \"pass\"\n    cmd_name = user_input[1:].split()[0]\n    command = COMMANDS.get(cmd_name)\n    if command is None:\n        console.print(f\"未知命令：/{cmd_name}，输入 /help 查看可用命令\\n\")\n        return \"continue\"\n    \n    result = command.handler(state)\n    if asyncio.iscoroutine(result):\n        result = await result\n    return \"continue\" if result else \"break\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
