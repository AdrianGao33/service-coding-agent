      "updated": 1792604853259,
      "link": null,
      "locked": false,
      "text": "def list_candidate_files() -> list[str]:\n    try:    \n        result = subprocess.run(\n            [\"git\", \"ls-files\"], capture_output=True, text=True, timeout=2\n        )\n        tracked = result.stdout.splitlines() if result.returncode == 0 else []\n        if tracked:\n            return tracked\n    except (OSError, subprocess.SubprocessError):\n        pass\n\n    files = []\n    for root, dirs, names in os.walk(\".\"):\n        dirs[:] = [d for d in dirs if not d.startswith(\".\") and d not in IGNORED_DIRS]\n        for name in names:\n            files.append(os.path.relpath(os.path.join(root, name)))\n    return files",
      "fontSize": 15.861975372570539,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def list_candidate_files() -> list[str]:\n    try:    \n        result = subprocess.run(\n            [\"git\", \"ls-files\"], capture_output=True, text=True, timeout=2\n        )\n        tracked = result.stdout.splitlines() if result.returncode == 0 else []\n        if tracked:\n            return tracked\n    except (OSError, subprocess.SubprocessError):\n        pass\n\n    files = []\n    for root, dirs, names in os.walk(\".\"):\n        dirs[:] = [d for d in dirs if not d.startswith(\".\") and d not in IGNORED_DIRS]\n        for name in names:\n            files.append(os.path.relpath(os.path.join(root, name)))\n    return files",
      "autoResize": true,
      "lineHeight": 1.25
    },
