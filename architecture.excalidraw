      "link": null,
      "locked": false,
      "text": "@fork_hooks.on.tool_execute\nasync def _memory_write_gate(ctx, *, call, tool_def, args, handler):\n    if call.tool_name == \"read_file\":\n        return await handler(args)\n    if call.tool_name in (\"write_file\", \"edit_file\") and store.is_memory_path(str(args.get(\"path\", \"\"))):\n        return await handler(args)\n    return f\"后台记忆 agent 只允许写记忆目录内的文件，这次 {call.tool_name} 调用被拒绝。\"",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@fork_hooks.on.tool_execute\nasync def _memory_write_gate(ctx, *, call, tool_def, args, handler):\n    if call.tool_name == \"read_file\":\n        return await handler(args)\n    if call.tool_name in (\"write_file\", \"edit_file\") and store.is_memory_path(str(args.get(\"path\", \"\"))):\n        return await handler(args)\n    return f\"后台记忆 agent 只允许写记忆目录内的文件，这次 {call.tool_name} 调用被拒绝。\"",
      "autoResize": true,
      "lineHeight": 1.25
    },
