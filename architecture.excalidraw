    {
      "id": "kpPq8AUo-61cY0yW-FLss",
      "type": "text",
      "x": -895.4980749971791,
      "y": -6219.7916284465655,
      "width": 756.7989501953125,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "x2-TcWd850owRl-3d8vC1",
        "dm2l2uLLTKvPbNVD2-ZwK"
      ],
      "frameId": null,
      "index": "bCQ",
      "roundness": null,
      "seed": 1275262755,
      "version": 1215,
      "versionNonce": 1755255698,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793345944543,
      "link": null,
      "locked": false,
      "text": "def restore_file_messages(old_state: ReadFileState, new_state: ReadFileState) -> list:\n    picked, used = [], 0\n    for path in reversed(old_state.paths()):\n        try:\n            size = os.path.getsize(path)\n        except OSError:\n            continue\n        if len(picked) >= RESTORE_MAX_FILES or used + size > RESTORE_MAX_CHARS:\n            break\n        picked.append(path)\n        used += size\n    \n    picked.reverse()\n    # 和 @ 引用同一套机制：伪装成 read_file 调用塞进历史，顺带登记进新 readFileState\n    return build_mention_messages(picked, new_state)",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def restore_file_messages(old_state: ReadFileState, new_state: ReadFileState) -> list:\n    picked, used = [], 0\n    for path in reversed(old_state.paths()):\n        try:\n            size = os.path.getsize(path)\n        except OSError:\n            continue\n        if len(picked) >= RESTORE_MAX_FILES or used + size > RESTORE_MAX_CHARS:\n            break\n        picked.append(path)\n        used += size\n    \n    picked.reverse()\n    # 和 @ 引用同一套机制：伪装成 read_file 调用塞进历史，顺带登记进新 readFileState\n    return build_mention_messages(picked, new_state)",
      "autoResize": true,
      "lineHeight": 1.25
    },
