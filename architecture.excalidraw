      "link": null,
      "locked": false,
      "text": "@hooks.on.before_model_request\nasync def _record_request(ctx, request_context):\n    msgs = list(request_context.messages)\n    last_part = msgs[-1].parts[-1] if msgs and msgs[-1].parts else None\n    try:\n        tool_names = [t.name for t in request_context.model_request_parameters.function_tools]\n    except AttributeError:\n        tool_names = []\n\n    api_call_log.append(ApiCall(\n        model=request_context.model.model_name,\n        messages_count=len(msgs),\n        last_part=last_part,\n        tools=tool_names,\n    ))\n    return request_context",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "@hooks.on.before_model_request\nasync def _record_request(ctx, request_context):\n    msgs = list(request_context.messages)\n    last_part = msgs[-1].parts[-1] if msgs and msgs[-1].parts else None\n    try:\n        tool_names = [t.name for t in request_context.model_request_parameters.function_tools]\n    except AttributeError:\n        tool_names = []\n\n    api_call_log.append(ApiCall(\n        model=request_context.model.model_name,\n        messages_count=len(msgs),\n        last_part=last_part,\n        tools=tool_names,\n    ))\n    return request_context",
      "autoResize": true,
      "lineHeight": 1.25
    },
