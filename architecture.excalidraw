      "text": "@hooks.on.tool_execute_error\nasync def _handle_tool_error(ctx, *, call, tool_def, args, error):\n    console.print(f\"[bold red]✗ 工具 {call.tool_name} 出错：{error}[/]\")   \n    return f\"工具执行出错：{type(error).__name__}: {error}\"",
