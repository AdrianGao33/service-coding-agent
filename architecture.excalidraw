      "text": "def task_get(ctx: RunContext[AgentDeps], task_id: str) -> dict:\n    task = ctx.deps.tasks_store.get(task_id)\n    if task is None:\n        raise ModelRetry(f\"task #{task_id} 不存在，可以先 task_list 看看现在有哪些 task\")\n    return asdict(task)",
