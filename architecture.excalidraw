      "updated": 1793345944543,
      "link": null,
      "locked": false,
      "text": "def extract_summary(text: str) -> str:\n    text = re.sub(r\"<analysis>.*?</analysis>\", \"\", text, flags=re.DOTALL)\n    match = re.search(r\"<summary>(.*?)</summary>\", text, re.DOTALL)\n    text = match.group(1) if match else text\n    # 正文里残留的标签字样一并清掉\n    return re.sub(r\"</?(analysis|summary)>\", \"\", text).strip()",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "def extract_summary(text: str) -> str:\n    text = re.sub(r\"<analysis>.*?</analysis>\", \"\", text, flags=re.DOTALL)\n    match = re.search(r\"<summary>(.*?)</summary>\", text, re.DOTALL)\n    text = match.group(1) if match else text\n    # 正文里残留的标签字样一并清掉\n    return re.sub(r\"</?(analysis|summary)>\", \"\", text).strip()",
      "autoResize": true,
      "lineHeight": 1.25
    },
