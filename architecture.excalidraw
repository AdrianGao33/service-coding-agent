      "link": null,
      "locked": false,
      "text": "JOBS_ROOT = Path.home() / \".my-code-agent\" / \"jobs\"\n\nclass JobRegistry:                                     \n    self.session_id                             # 会话sessionId  \n    self._jobs: dict[str, Job] = {}             # job_id : Job （一对一的关系）\n    self._jobs_dir = JOBS_ROOT / session_id     # 后台任务输出结果存放地址 \n    self._watchers: set = set()                 # 防止Python垃圾回收，异步任务存入集合",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "JOBS_ROOT = Path.home() / \".my-code-agent\" / \"jobs\"\n\nclass JobRegistry:                                     \n    self.session_id                             # 会话sessionId  \n    self._jobs: dict[str, Job] = {}             # job_id : Job （一对一的关系）\n    self._jobs_dir = JOBS_ROOT / session_id     # 后台任务输出结果存放地址 \n    self._watchers: set = set()                 # 防止Python垃圾回收，异步任务存入集合",
      "autoResize": true,
      "lineHeight": 1.25
    },
